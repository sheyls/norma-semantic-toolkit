# ABox from: regulations/eu-ai-act/bpmn
# TBox:    https://w3id.org/def/norma-o

@prefix norma: <https://w3id.org/def/norma-o#> .
@prefix :      <https://w3id.org/norma-abox/eu-ai-act#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix eli:   <http://data.europa.eu/eli/ontology#> .

<https://w3id.org/norma-abox/eu-ai-act>
    a owl:Ontology ;
    owl:imports <https://w3id.org/def/norma-o> .

# ── Agents ───────────────────────────────────────────────────────
:Agent_AI_provider
    a owl:NamedIndividual, norma:LegalAgent ;
    rdfs:label "AI provider"@en .

# ── Legal Actions ────────────────────────────────────────────────
:Action_comply
    a owl:NamedIndividual, norma:LegalAction ;
    rdfs:label "comply"@en .

# ── Legal Objects ────────────────────────────────────────────────
:Object_AI_system
    a owl:NamedIndividual, norma:LegalObject ;
    rdfs:label "AI system"@en .

# ── Legal Sources ────────────────────────────────────────────────
:Regulation_EU_AI_Act
    a owl:NamedIndividual, norma:LegalSource ;
    norma:regulationName "EU AI Act"^^xsd:string ;
    norma:articleNumber "8 to 22"^^xsd:string ;
    norma:articleNumber "60 and 61"^^xsd:string.

# ── Annotator Agents ─────────────────────────────────────────────
:NORMAAnnotator
    a owl:NamedIndividual, norma:AnnotatorAgent ;
    rdfs:label "NORMA Legal Expert"@en .

# ── Norms ────────────────────────────────────────────────────────────
:OBL_Respect_high_risk_obligations
    a owl:NamedIndividual, <https://w3id.org/def/norma-o#Obligation> ;
    rdfs:label "Respect high-risk obligations"@en ;
    norma:deonticId "OBL_Respect_high_risk_obligations"^^xsd:string ;
    norma:actionText "comply"^^xsd:string ;
    norma:agentText "AI provider"^^xsd:string ;
    norma:objectText "AI system"^^xsd:string ;
    norma:fromRegulation "EU AI Act"^^xsd:string ;
    norma:fromArticle "8 to 22"^^xsd:string ;
    norma:hasBindingForce <https://w3id.org/def/norma-o#HardLaw> ;
    norma:hasNormStatus <https://w3id.org/def/norma-o#Active> ;
    norma:hasComplianceCriticality <https://w3id.org/def/norma-o#High> ;
    norma:hasExtractionMethod <https://w3id.org/def/norma-o#ManualLawyer> ;
    norma:hasReviewStatus <https://w3id.org/def/norma-o#PendingReview> ;
    norma:hasLegalAgent  :Agent_AI_provider ;
    norma:hasLegalAction :Action_comply ;
    norma:hasLegalObject :Object_AI_system ;
    norma:hasLegalSource :Regulation_EU_AI_Act ;
    norma:wasDerivedFromSource :Regulation_EU_AI_Act ;
    norma:wasAttributedToAnnotator :NORMAAnnotator ;
    norma:wasGeneratedByAnnotationActivity :AnnotationActivity_OBL_Respect_high_risk_obligations.

:OBL_ADD_testing_obligations
    a owl:NamedIndividual, <https://w3id.org/def/norma-o#Obligation> ;
    rdfs:label "ADD testing obligations"@en ;
    norma:deonticId "OBL_ADD_testing_obligations"^^xsd:string ;
    norma:actionText "comply"^^xsd:string ;
    norma:agentText "AI provider"^^xsd:string ;
    norma:objectText "AI system"^^xsd:string ;
    norma:fromRegulation "EU AI Act"^^xsd:string ;
    norma:fromArticle "60 and 61"^^xsd:string ;
    norma:hasBindingForce <https://w3id.org/def/norma-o#HardLaw> ;
    norma:hasNormStatus <https://w3id.org/def/norma-o#Active> ;
    norma:hasComplianceCriticality <https://w3id.org/def/norma-o#High> ;
    norma:hasExtractionMethod <https://w3id.org/def/norma-o#ManualLawyer> ;
    norma:hasReviewStatus <https://w3id.org/def/norma-o#PendingReview> ;
    norma:hasLegalAgent  :Agent_AI_provider ;
    norma:hasLegalAction :Action_comply ;
    norma:hasLegalObject :Object_AI_system ;
    norma:hasLegalSource :Regulation_EU_AI_Act ;
    norma:wasDerivedFromSource :Regulation_EU_AI_Act ;
    norma:wasAttributedToAnnotator :NORMAAnnotator ;
    norma:wasGeneratedByAnnotationActivity :AnnotationActivity_OBL_ADD_testing_obligations.

# ── Legal Conditions (Gateways) ──────────────────────────────────────
:Condition_Is_the_AI_system_used_for_biometric_purposes
    a owl:NamedIndividual, norma:LegalCondition ;
    rdfs:label "Is the AI system used for biometric purposes?"@en ;
    norma:conditionStatement "Is the AI system used for biometric purposes?"^^xsd:string ;
    norma:hasTrigger :TriggerEvent_Condition_Is_the_AI_system_used_for_biometric_purposes_True_OBL_ADD_testing_obligations ;
    norma:hasTrigger :TriggerEvent_Condition_Is_the_AI_system_used_for_biometric_purposes_True_OBL_Respect_high_risk_obligations.

:TriggerEvent_Condition_Is_the_AI_system_used_for_biometric_purposes_True_OBL_ADD_testing_obligations
    a owl:NamedIndividual, norma:TriggerEvent ;
    norma:hasOutcome norma:TrueOutcome .

:TriggerEvent_Condition_Is_the_AI_system_used_for_biometric_purposes_True_OBL_Respect_high_risk_obligations
    a owl:NamedIndividual, norma:TriggerEvent ;
    norma:hasOutcome norma:TrueOutcome .

:Condition_Is_the_AI_system_tested_in_real_life_before_entering_into_the_market
    a owl:NamedIndividual, norma:LegalCondition ;
    rdfs:label "Is the AI system tested in real-life before entering into the market?"@en ;
    norma:conditionStatement "Is the AI system tested in real-life before entering into the market?"^^xsd:string ;
    norma:hasTrigger :TriggerEvent_Condition_Is_the_AI_system_tested_in_real_life_before_entering_into_the_market_False_OBL_Respect_high_risk_obligations ;
    norma:hasTrigger :TriggerEvent_Condition_Is_the_AI_system_tested_in_real_life_before_entering_into_the_market_True_OBL_ADD_testing_obligations ;
    norma:hasTrigger :TriggerEvent_Condition_Is_the_AI_system_tested_in_real_life_before_entering_into_the_market_True_OBL_Respect_high_risk_obligations.

:TriggerEvent_Condition_Is_the_AI_system_tested_in_real_life_before_entering_into_the_market_False_OBL_Respect_high_risk_obligations
    a owl:NamedIndividual, norma:TriggerEvent ;
    norma:hasOutcome norma:FalseOutcome .

:TriggerEvent_Condition_Is_the_AI_system_tested_in_real_life_before_entering_into_the_market_True_OBL_ADD_testing_obligations
    a owl:NamedIndividual, norma:TriggerEvent ;
    norma:hasOutcome norma:TrueOutcome .

:TriggerEvent_Condition_Is_the_AI_system_tested_in_real_life_before_entering_into_the_market_True_OBL_Respect_high_risk_obligations
    a owl:NamedIndividual, norma:TriggerEvent ;
    norma:hasOutcome norma:TrueOutcome .

# ── Annotation Activities ─────────────────────────────────────────
:AnnotationActivity_OBL_Respect_high_risk_obligations
    a owl:NamedIndividual, norma:AnnotationActivity ;
    rdfs:label "Annotation activity for OBL_Respect_high_risk_obligations"@en ;
    norma:annotationDate "2026-04-26"^^xsd:date ;
    norma:confidenceScore "1.0"^^xsd:decimal ;
    norma:wasAssociatedWithAnnotator :NORMAAnnotator ;
    norma:usedLegalSource :Regulation_EU_AI_Act.

:AnnotationActivity_OBL_ADD_testing_obligations
    a owl:NamedIndividual, norma:AnnotationActivity ;
    rdfs:label "Annotation activity for OBL_ADD_testing_obligations"@en ;
    norma:annotationDate "2026-04-26"^^xsd:date ;
    norma:confidenceScore "1.0"^^xsd:decimal ;
    norma:wasAssociatedWithAnnotator :NORMAAnnotator ;
    norma:usedLegalSource :Regulation_EU_AI_Act.
