<?xml version="1.0"?>
<rdf:RDF
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:swrl="http://www.w3.org/2003/11/swrl#"
  xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
  xml:base="http://example.org/bpmn2rules">

  <owl:Ontology rdf:about="http://example.org/bpmn2rules"/>

  <!-- Datatype Properties -->
  <owl:DatatypeProperty rdf:about="http://example.org/bpmn2rules#Generation_of_syntetic_content"/>
  <owl:DatatypeProperty rdf:about="http://example.org/bpmn2rules#fromArticle"/>
  <owl:DatatypeProperty rdf:about="http://example.org/bpmn2rules#fromParagraph"/>
  <owl:DatatypeProperty rdf:about="http://example.org/bpmn2rules#fromRegulation"/>
  <owl:DatatypeProperty rdf:about="http://example.org/bpmn2rules#hasBindingForce"/>
  <owl:DatatypeProperty rdf:about="http://example.org/bpmn2rules#hasDeonticId"/>
  <owl:DatatypeProperty rdf:about="http://example.org/bpmn2rules#hasDeonticType"/>
  <owl:DatatypeProperty rdf:about="http://example.org/bpmn2rules#hasRiskLevel"/>
  <owl:DatatypeProperty rdf:about="http://example.org/bpmn2rules#obligation"/>
  <owl:DatatypeProperty rdf:about="http://example.org/bpmn2rules#recommendation"/>
  <owl:DatatypeProperty rdf:about="http://example.org/bpmn2rules#regulationURI"/>
  <owl:DatatypeProperty rdf:about="http://example.org/bpmn2rules#task"/>

  <!-- Object Properties -->
  <owl:ObjectProperty rdf:about="http://example.org/bpmn2rules#actsOn"/>
  <owl:ObjectProperty rdf:about="http://example.org/bpmn2rules#performsAction"/>

  <!-- Variables -->
  <swrl:Variable rdf:about="http://example.org/bpmn2rules#var_AI_owner"/>
  <swrl:Variable rdf:about="http://example.org/bpmn2rules#var_x"/>

  <!-- SWRL Rules -->
  <swrl:Imp rdf:about="http://example.org/bpmn2rules#r1">
    <swrl:body>
        <swrl:AtomList>
          <rdf:first>
            <swrl:DatavaluedPropertyAtom>
              <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#Generation_of_syntetic_content"/>
              <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#var_x"/>
              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2>
            </swrl:DatavaluedPropertyAtom>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </swrl:AtomList>
    </swrl:body>
    <swrl:head>
        <swrl:AtomList>
          <rdf:first>
            <swrl:DatavaluedPropertyAtom>
              <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#obligation"/>
              <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#var_AI_owner"/>
              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OBLIGATION|OBL_1|Marking_obligation|generate_content</swrl:argument2>
            </swrl:DatavaluedPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <swrl:AtomList>
              <rdf:first>
                <swrl:IndividualPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#performsAction"/>
                  <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#AI_owner"/>
                  <swrl:argument2 rdf:resource="http://example.org/bpmn2rules#OBL_1"/>
                </swrl:IndividualPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <swrl:AtomList>
                  <rdf:first>
                    <swrl:IndividualPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#actsOn"/>
                      <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#OBL_1"/>
                      <swrl:argument2 rdf:resource="http://example.org/bpmn2rules#generate_content"/>
                    </swrl:IndividualPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <swrl:AtomList>
                      <rdf:first>
                        <swrl:DatavaluedPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#hasDeonticType"/>
                          <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#OBL_1"/>
                          <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">obligation</swrl:argument2>
                        </swrl:DatavaluedPropertyAtom>
                      </rdf:first>
                      <rdf:rest>
                        <swrl:AtomList>
                          <rdf:first>
                            <swrl:DatavaluedPropertyAtom>
                              <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#hasDeonticId"/>
                              <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#OBL_1"/>
                              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OBL_1</swrl:argument2>
                            </swrl:DatavaluedPropertyAtom>
                          </rdf:first>
                          <rdf:rest>
                            <swrl:AtomList>
                              <rdf:first>
                                <swrl:DatavaluedPropertyAtom>
                                  <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#hasBindingForce"/>
                                  <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#OBL_1"/>
                                  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hard_law</swrl:argument2>
                                </swrl:DatavaluedPropertyAtom>
                              </rdf:first>
                              <rdf:rest>
                                <swrl:AtomList>
                                  <rdf:first>
                                    <swrl:DatavaluedPropertyAtom>
                                      <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#fromRegulation"/>
                                      <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#OBL_1"/>
                                      <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IA_act</swrl:argument2>
                                    </swrl:DatavaluedPropertyAtom>
                                  </rdf:first>
                                  <rdf:rest>
                                    <swrl:AtomList>
                                      <rdf:first>
                                        <swrl:DatavaluedPropertyAtom>
                                          <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#fromArticle"/>
                                          <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#OBL_1"/>
                                          <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4</swrl:argument2>
                                        </swrl:DatavaluedPropertyAtom>
                                      </rdf:first>
                                      <rdf:rest>
                                        <swrl:AtomList>
                                          <rdf:first>
                                            <swrl:DatavaluedPropertyAtom>
                                              <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#fromParagraph"/>
                                              <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#OBL_1"/>
                                              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2</swrl:argument2>
                                            </swrl:DatavaluedPropertyAtom>
                                          </rdf:first>
                                          <rdf:rest>
                                            <swrl:AtomList>
                                              <rdf:first>
                                                <swrl:DatavaluedPropertyAtom>
                                                  <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#regulationURI"/>
                                                  <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#OBL_1"/>
                                                  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">hhtps://</swrl:argument2>
                                                </swrl:DatavaluedPropertyAtom>
                                              </rdf:first>
                                              <rdf:rest>
                                                <swrl:AtomList>
                                                  <rdf:first>
                                                    <swrl:DatavaluedPropertyAtom>
                                                      <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#hasRiskLevel"/>
                                                      <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#OBL_1"/>
                                                      <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high</swrl:argument2>
                                                    </swrl:DatavaluedPropertyAtom>
                                                  </rdf:first>
                                                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                </swrl:AtomList>
                                              </rdf:rest>
                                            </swrl:AtomList>
                                          </rdf:rest>
                                        </swrl:AtomList>
                                      </rdf:rest>
                                    </swrl:AtomList>
                                  </rdf:rest>
                                </swrl:AtomList>
                              </rdf:rest>
                            </swrl:AtomList>
                          </rdf:rest>
                        </swrl:AtomList>
                      </rdf:rest>
                    </swrl:AtomList>
                  </rdf:rest>
                </swrl:AtomList>
              </rdf:rest>
            </swrl:AtomList>
          </rdf:rest>
        </swrl:AtomList>
    </swrl:head>
  </swrl:Imp>

  <swrl:Imp rdf:about="http://example.org/bpmn2rules#r2">
    <swrl:body>
        <swrl:AtomList>
          <rdf:first>
            <swrl:DatavaluedPropertyAtom>
              <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#Generation_of_syntetic_content"/>
              <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#var_x"/>
              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</swrl:argument2>
            </swrl:DatavaluedPropertyAtom>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </swrl:AtomList>
    </swrl:body>
    <swrl:head>
        <swrl:AtomList>
          <rdf:first>
            <swrl:DatavaluedPropertyAtom>
              <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#recommendation"/>
              <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#var_AI_owner"/>
              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RECOMMENDATION|REC_1|Adopt_volutary_codes_of_conduct|generated_content</swrl:argument2>
            </swrl:DatavaluedPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <swrl:AtomList>
              <rdf:first>
                <swrl:IndividualPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#performsAction"/>
                  <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#AI_owner"/>
                  <swrl:argument2 rdf:resource="http://example.org/bpmn2rules#REC_1"/>
                </swrl:IndividualPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <swrl:AtomList>
                  <rdf:first>
                    <swrl:IndividualPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#actsOn"/>
                      <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#REC_1"/>
                      <swrl:argument2 rdf:resource="http://example.org/bpmn2rules#generated_content"/>
                    </swrl:IndividualPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <swrl:AtomList>
                      <rdf:first>
                        <swrl:DatavaluedPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#hasDeonticType"/>
                          <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#REC_1"/>
                          <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">recommendation</swrl:argument2>
                        </swrl:DatavaluedPropertyAtom>
                      </rdf:first>
                      <rdf:rest>
                        <swrl:AtomList>
                          <rdf:first>
                            <swrl:DatavaluedPropertyAtom>
                              <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#hasDeonticId"/>
                              <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#REC_1"/>
                              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">REC_1</swrl:argument2>
                            </swrl:DatavaluedPropertyAtom>
                          </rdf:first>
                          <rdf:rest>
                            <swrl:AtomList>
                              <rdf:first>
                                <swrl:DatavaluedPropertyAtom>
                                  <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#hasBindingForce"/>
                                  <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#REC_1"/>
                                  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soft_law</swrl:argument2>
                                </swrl:DatavaluedPropertyAtom>
                              </rdf:first>
                              <rdf:rest>
                                <swrl:AtomList>
                                  <rdf:first>
                                    <swrl:DatavaluedPropertyAtom>
                                      <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#fromRegulation"/>
                                      <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#REC_1"/>
                                      <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IA_act</swrl:argument2>
                                    </swrl:DatavaluedPropertyAtom>
                                  </rdf:first>
                                  <rdf:rest>
                                    <swrl:AtomList>
                                      <rdf:first>
                                        <swrl:DatavaluedPropertyAtom>
                                          <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#fromArticle"/>
                                          <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#REC_1"/>
                                          <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5</swrl:argument2>
                                        </swrl:DatavaluedPropertyAtom>
                                      </rdf:first>
                                      <rdf:rest>
                                        <swrl:AtomList>
                                          <rdf:first>
                                            <swrl:DatavaluedPropertyAtom>
                                              <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#fromParagraph"/>
                                              <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#REC_1"/>
                                              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2</swrl:argument2>
                                            </swrl:DatavaluedPropertyAtom>
                                          </rdf:first>
                                          <rdf:rest>
                                            <swrl:AtomList>
                                              <rdf:first>
                                                <swrl:DatavaluedPropertyAtom>
                                                  <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#regulationURI"/>
                                                  <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#REC_1"/>
                                                  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">hhtps://...</swrl:argument2>
                                                </swrl:DatavaluedPropertyAtom>
                                              </rdf:first>
                                              <rdf:rest>
                                                <swrl:AtomList>
                                                  <rdf:first>
                                                    <swrl:DatavaluedPropertyAtom>
                                                      <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#hasRiskLevel"/>
                                                      <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#REC_1"/>
                                                      <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</swrl:argument2>
                                                    </swrl:DatavaluedPropertyAtom>
                                                  </rdf:first>
                                                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                </swrl:AtomList>
                                              </rdf:rest>
                                            </swrl:AtomList>
                                          </rdf:rest>
                                        </swrl:AtomList>
                                      </rdf:rest>
                                    </swrl:AtomList>
                                  </rdf:rest>
                                </swrl:AtomList>
                              </rdf:rest>
                            </swrl:AtomList>
                          </rdf:rest>
                        </swrl:AtomList>
                      </rdf:rest>
                    </swrl:AtomList>
                  </rdf:rest>
                </swrl:AtomList>
              </rdf:rest>
            </swrl:AtomList>
          </rdf:rest>
        </swrl:AtomList>
    </swrl:head>
  </swrl:Imp>

</rdf:RDF>
