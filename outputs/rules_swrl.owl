<?xml version="1.0"?>
<rdf:RDF
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:swrl="http://www.w3.org/2003/11/swrl#"
  xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
  xmlns:ruleml="http://www.w3.org/2003/11/ruleml#"
  xml:base="http://example.org/bpmn2rules">

  <owl:Ontology rdf:about="http://example.org/bpmn2rules"/>

  <owl:DatatypeProperty rdf:about="http://example.org/bpmn2rules#obligation"/>
  <owl:DatatypeProperty rdf:about="http://example.org/bpmn2rules#ofsynteticcontent"/>
  <owl:DatatypeProperty rdf:about="http://example.org/bpmn2rules#permission"/>
  <owl:DatatypeProperty rdf:about="http://example.org/bpmn2rules#task"/>

  <swrl:Variable rdf:about="http://example.org/bpmn2rules#var_AI_owner"/>
  <swrl:Variable rdf:about="http://example.org/bpmn2rules#var_Generation"/>

  <!-- SWRL Rules -->
  <swrl:Imp rdf:about="http://example.org/bpmn2rules#r1">
    <swrl:body>
        <swrl:AtomList>
          <rdf:first>
            <swrl:DatavaluedPropertyAtom>
              <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#ofsynteticcontent"/>
              <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#var_Generation"/>
              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2>
            </swrl:DatavaluedPropertyAtom>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </swrl:AtomList>
    </swrl:body>
    <swrl:head>
        <swrl:AtomList>
          <rdf:first>
            <swrl:DatavaluedPropertyAtom>
              <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#obligation"/>
              <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#var_AI_owner"/>
              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OBLIGATION|OBL_001|marking_as_synthetic|AI_content|IA_act|4|2</swrl:argument2>
            </swrl:DatavaluedPropertyAtom>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </swrl:AtomList>
    </swrl:head>
  </swrl:Imp>

  <swrl:Imp rdf:about="http://example.org/bpmn2rules#r2">
    <swrl:body>
        <swrl:AtomList>
          <rdf:first>
            <swrl:DatavaluedPropertyAtom>
              <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#ofsynteticcontent"/>
              <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#var_Generation"/>
              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</swrl:argument2>
            </swrl:DatavaluedPropertyAtom>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </swrl:AtomList>
    </swrl:body>
    <swrl:head>
        <swrl:AtomList>
          <rdf:first>
            <swrl:DatavaluedPropertyAtom>
              <swrl:propertyPredicate rdf:resource="http://example.org/bpmn2rules#permission"/>
              <swrl:argument1 rdf:resource="http://example.org/bpmn2rules#var_AI_owner"/>
              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PERMISSION|PER_001|conduct_voluntary_code|you|IA_act|5|2</swrl:argument2>
            </swrl:DatavaluedPropertyAtom>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </swrl:AtomList>
    </swrl:head>
  </swrl:Imp>

</rdf:RDF>
