<?xml version="1.0" encoding="UTF-8"?>
<lrml:LegalRuleML
  xmlns:lrml="http://docs.oasis-open.org/legalruleml/ns/v1.0/"
  xmlns:ruleml="http://ruleml.org/spec"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <lrml:Statements>
    <lrml:PrescriptiveStatement key="r1">
      <ruleml:Rule key="r1">
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel>Generation_of_syntetic_content</ruleml:Rel>
            <ruleml:Var>x</ruleml:Var>
            <ruleml:Data xsi:type="xs:boolean">true</ruleml:Data>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>task</ruleml:Rel>
            <ruleml:Var>AI_owner</ruleml:Var>
            <ruleml:Data xsi:type="xs:string">OBLIGATION|OBL_1|Marking_obligation|generate_content</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>

    <lrml:PrescriptiveStatement key="r2">
      <ruleml:Rule key="r2">
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel>Generation_of_syntetic_content</ruleml:Rel>
            <ruleml:Var>x</ruleml:Var>
            <ruleml:Data xsi:type="xs:boolean">false</ruleml:Data>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>task</ruleml:Rel>
            <ruleml:Var>AI_owner</ruleml:Var>
            <ruleml:Data xsi:type="xs:string">RECOMMENDATION|REC_1|Adopt_volutary_codes_of_conduct|generated_content</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>

    <lrml:OverrideStatement>
      <lrml:Override over="#r1" under="#r2"/>
    </lrml:OverrideStatement>
  </lrml:Statements>

</lrml:LegalRuleML>
