{
  "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name": "NORMA — Legal Compliance Annotation",
  "id": "norma.compliance.annotation.v1",
  "description": "Legal compliance annotation for BPMN tasks and exclusive gateways in the NORMA workflow.",
  "version": 1,
  "appliesTo": [
    "bpmn:Task",
    "bpmn:UserTask",
    "bpmn:ServiceTask",
    "bpmn:ManualTask",
    "bpmn:BusinessRuleTask",
    "bpmn:SendTask",
    "bpmn:ExclusiveGateway"
  ],
  "groups": [
    { "id": "elementType",  "label": "Element Type" },
    { "id": "deontic",      "label": "Norm Content" },
    { "id": "condition",    "label": "Legal Condition" },
    { "id": "scope",        "label": "Scope & Temporal" },
    { "id": "consequence",  "label": "Consequences & Exceptions" },
    { "id": "legalSource",  "label": "Legal Source" },
    { "id": "metadata",     "label": "Annotation Metadata" }
  ],
  "properties": [
    {
      "id": "elementType",
      "label": "Element Type",
      "description": "Choose whether this BPMN element contains a norm or evaluates a legal condition.",
      "type": "Dropdown",
      "group": "elementType",
      "binding": { "type": "zeebe:property", "name": "compliance_elementType" },
      "choices": [
        { "name": "🟦 Task — contains a deontic norm or constitutive rule", "value": "task" },
        { "name": "🔷 Exclusive Gateway — evaluates a legal condition", "value": "exclusiveGateway" }
      ],
      "value": "task"
    },

    {
      "id": "deonticType",
      "label": "Deontic Modality",
      "description": "Choose the legal modality of the norm.",
      "type": "Dropdown",
      "group": "deontic",
      "binding": { "type": "zeebe:property", "name": "compliance_deonticType" },
      "choices": [
        { "name": "🔴 Obligation — MUST", "value": "obligation" },
        { "name": "🚫 Prohibition — MUST NOT", "value": "prohibition" },
        { "name": "✅ Permission — MAY", "value": "permission" },
        { "name": "🟡 Recommendation — SHOULD", "value": "recommendation" },
        { "name": "🟠 Negative Recommendation — SHOULD NOT", "value": "recommendation_not" },
        { "name": "📘 Constitutive Rule / Fact", "value": "fact" }
      ],
      "value": "obligation",
      "condition": { "property": "elementType", "equals": "task" }
    },

    {
      "label": "Norm Statement",
      "description": "Human-readable restatement of the norm for legal and audit purposes.",
      "type": "Text",
      "group": "deontic",
      "binding": { "type": "zeebe:property", "name": "compliance_normStatement" },
      "value": "",
      "condition": { "property": "elementType", "equals": "task" }
    },

    {
      "label": "Responsible Party (Who)",
      "description": "Entity that is legally required, forbidden, permitted, or recommended to act. Example: AI Provider, Data Controller, Manufacturer.",
      "type": "String",
      "group": "deontic",
      "binding": { "type": "zeebe:property", "name": "compliance_agent" },
      "value": "",
      "constraints": { "notEmpty": true },
      "condition": {
        "allMatch": [
          { "property": "elementType", "equals": "task" },
          { "property": "deonticType", "oneOf": ["obligation", "prohibition", "permission", "recommendation", "recommendation_not"] }
        ]
      }
    },

    {
      "label": "Legal Action (What)",
      "description": "Verb phrase describing what the responsible party must, must not, may, or should do.",
      "type": "String",
      "group": "deontic",
      "binding": { "type": "zeebe:property", "name": "compliance_action" },
      "value": "",
      "constraints": { "notEmpty": true },
      "condition": {
        "allMatch": [
          { "property": "elementType", "equals": "task" },
          { "property": "deonticType", "oneOf": ["obligation", "prohibition", "permission", "recommendation", "recommendation_not"] }
        ]
      }
    },

    {
      "label": "Legal Object / Target (On What?)",
      "description": "Entity, resource, document, system, data, or content to which the action relates.",
      "type": "String",
      "group": "deontic",
      "binding": { "type": "zeebe:property", "name": "compliance_object" },
      "value": "",
      "constraints": { "notEmpty": true },
      "condition": {
        "allMatch": [
          { "property": "elementType", "equals": "task" },
          { "property": "deonticType", "oneOf": ["obligation", "prohibition", "permission", "recommendation", "recommendation_not"] }
        ]
      }
    },

    {
      "label": "Constitutive Rule / Fact Statement",
      "description": "Plain-language statement of the legal classification, constitutive rule, or legal fact.",
      "type": "Text",
      "group": "deontic",
      "binding": { "type": "zeebe:property", "name": "compliance_factStatement" },
      "value": "",
      "constraints": { "notEmpty": true },
      "condition": {
        "allMatch": [
          { "property": "elementType", "equals": "task" },
          { "property": "deonticType", "equals": "fact" }
        ]
      }
    },

    {
      "label": "Binding Force",
      "description": "Legal force of the norm.",
      "type": "Dropdown",
      "group": "deontic",
      "binding": { "type": "zeebe:property", "name": "compliance_bindingForce" },
      "choices": [
        { "name": "Hard law (legally binding)", "value": "hard_law" },
        { "name": "Soft law (guidelines, standards)", "value": "soft_law" },
        { "name": "Internal policy", "value": "internal_policy" },
        { "name": "Contractual obligation", "value": "contractual" }
      ],
      "value": "hard_law",
      "condition": {
        "allMatch": [
          { "property": "elementType", "equals": "task" },
          { "property": "deonticType", "oneOf": ["obligation", "prohibition", "permission", "recommendation", "recommendation_not"] }
        ]
      }
    },

    {
      "label": "Condition Statement",
      "description": "Plain language legal question evaluated at this gateway.",
      "type": "Text",
      "group": "condition",
      "binding": { "type": "zeebe:property", "name": "gw_conditionStatement" },
      "value": "",
      "constraints": { "notEmpty": true },
      "condition": { "property": "elementType", "equals": "exclusiveGateway" }
    },

    {
      "label": "True Branch Label",
      "description": "Label of the outgoing branch when the condition is satisfied.",
      "type": "String",
      "group": "condition",
      "binding": { "type": "zeebe:property", "name": "gw_trueBranch" },
      "value": "Yes",
      "condition": { "property": "elementType", "equals": "exclusiveGateway" }
    },

    {
      "label": "False Branch Label",
      "description": "Label of the outgoing branch when the condition is not satisfied.",
      "type": "String",
      "group": "condition",
      "binding": { "type": "zeebe:property", "name": "gw_falseBranch" },
      "value": "No",
      "condition": { "property": "elementType", "equals": "exclusiveGateway" }
    },

    {
      "label": "Trigger Condition",
      "description": "Free-text description of the circumstances in which the norm applies.",
      "type": "Text",
      "group": "scope",
      "binding": { "type": "zeebe:property", "name": "compliance_triggerCondition" },
      "value": "",
      "condition": {
        "allMatch": [
          { "property": "elementType", "equals": "task" },
          { "property": "deonticType", "oneOf": ["obligation", "prohibition", "permission", "recommendation", "recommendation_not"] }
        ]
      }
    },

    {
      "label": "Jurisdiction",
      "description": "Geographic or legal scope. Example: EU, UK, US-CA, global.",
      "type": "String",
      "group": "scope",
      "binding": { "type": "zeebe:property", "name": "compliance_jurisdiction" },
      "value": "",
      "condition": { "property": "elementType", "equals": "task" }
    },

    {
      "label": "Effective Date (YYYY-MM-DD)",
      "description": "Date from which this norm is in force.",
      "type": "String",
      "group": "scope",
      "binding": { "type": "zeebe:property", "name": "compliance_effectiveDate" },
      "value": "",
      "condition": { "property": "elementType", "equals": "task" }
    },

    {
      "label": "Deadline / Sunset Date (YYYY-MM-DD)",
      "description": "Date after which this norm ceases to apply, if applicable.",
      "type": "String",
      "group": "scope",
      "binding": { "type": "zeebe:property", "name": "compliance_deadline" },
      "value": "",
      "condition": { "property": "elementType", "equals": "task" }
    },

    {
      "label": "Norm Status",
      "description": "Current lifecycle status of the norm.",
      "type": "Dropdown",
      "group": "scope",
      "binding": { "type": "zeebe:property", "name": "compliance_status" },
      "choices": [
        { "name": "Active", "value": "active" },
        { "name": "Under review", "value": "under_review" },
        { "name": "Disputed", "value": "disputed" },
        { "name": "Superseded", "value": "superseded" },
        { "name": "Not yet in force", "value": "pending" }
      ],
      "value": "active",
      "condition": { "property": "elementType", "equals": "task" }
    },

    {
      "label": "Exception / Carve-out",
      "description": "Conditions under which the norm does not apply.",
      "type": "Text",
      "group": "consequence",
      "binding": { "type": "zeebe:property", "name": "compliance_exception" },
      "value": "",
      "condition": {
        "allMatch": [
          { "property": "elementType", "equals": "task" },
          { "property": "deonticType", "oneOf": ["obligation", "prohibition", "permission", "recommendation", "recommendation_not"] }
        ]
      }
    },

    {
      "label": "Sanction / Consequence of Breach",
      "description": "Consequence of non-compliance, where known.",
      "type": "Text",
      "group": "consequence",
      "binding": { "type": "zeebe:property", "name": "compliance_sanction" },
      "value": "",
      "condition": {
        "allMatch": [
          { "property": "elementType", "equals": "task" },
          { "property": "deonticType", "oneOf": ["obligation", "prohibition", "permission", "recommendation", "recommendation_not"] }
        ]
      }
    },

    {
      "label": "Compliance Criticality",
      "description": "Severity of non-compliance associated with this norm.",
      "type": "Dropdown",
      "group": "consequence",
      "binding": { "type": "zeebe:property", "name": "compliance_riskLevel" },
      "choices": [
        { "name": "Critical", "value": "critical" },
        { "name": "High", "value": "high" },
        { "name": "Medium", "value": "medium" },
        { "name": "Low", "value": "low" }
      ],
      "value": "high",
      "condition": {
        "allMatch": [
          { "property": "elementType", "equals": "task" },
          { "property": "deonticType", "oneOf": ["obligation", "prohibition", "permission", "recommendation", "recommendation_not"] }
        ]
      }
    },

    {
      "label": "Regulation Name",
      "description": "Name of the legal source from which the norm is derived.",
      "type": "String",
      "group": "legalSource",
      "binding": { "type": "zeebe:property", "name": "compliance_regulation" },
      "value": "",
      "constraints": { "notEmpty": true },
      "condition": { "property": "elementType", "equals": "task" }
    },

    {
      "label": "Article / Section",
      "description": "Article, section, or equivalent unit within the legal source.",
      "type": "String",
      "group": "legalSource",
      "binding": { "type": "zeebe:property", "name": "compliance_article" },
      "value": "",
      "condition": { "property": "elementType", "equals": "task" }
    },

    {
      "label": "Paragraph / Subsection",
      "description": "Paragraph, subsection, or other more specific locator within the legal source.",
      "type": "String",
      "group": "legalSource",
      "binding": { "type": "zeebe:property", "name": "compliance_paragraph" },
      "value": "",
      "condition": { "property": "elementType", "equals": "task" }
    },

    {
      "label": "Original Legal Text",
      "description": "Quoted legal text supporting the annotation.",
      "type": "Text",
      "group": "legalSource",
      "binding": { "type": "zeebe:property", "name": "compliance_originalText" },
      "value": "",
      "condition": { "property": "elementType", "equals": "task" }
    },

    {
      "label": "Regulation URI",
      "description": "Stable URI of the legal source, where available.",
      "type": "String",
      "group": "legalSource",
      "binding": { "type": "zeebe:property", "name": "compliance_regulationURI" },
      "value": "",
      "condition": { "property": "elementType", "equals": "task" }
    },

    {
      "label": "Extraction Method",
      "description": "How this annotation was produced.",
      "type": "Dropdown",
      "group": "metadata",
      "binding": { "type": "zeebe:property", "name": "compliance_extractionMethod" },
      "choices": [
        { "name": "Manual annotation (lawyer)", "value": "manual_lawyer" },
        { "name": "Manual annotation (analyst)", "value": "manual_analyst" },
        { "name": "LLM extraction", "value": "llm" },
        { "name": "Pattern matching", "value": "pattern-matching" },
        { "name": "Rule-based extraction", "value": "rule-based" }
      ],
      "value": "manual_lawyer",
      "condition": { "property": "elementType", "equals": "task" }
    },

    {
      "label": "Confidence Score (0.0–1.0)",
      "description": "Annotator confidence in the interpretation.",
      "type": "String",
      "group": "metadata",
      "binding": { "type": "zeebe:property", "name": "compliance_confidence" },
      "value": "1.0",
      "constraints": {
        "pattern": {
          "value": "^(0(\\.[0-9]+)?|1(\\.0+)?)$",
          "message": "Must be a decimal between 0.0 and 1.0"
        }
      },
      "condition": { "property": "elementType", "equals": "task" }
    },

    {
      "label": "Legal Review Status",
      "description": "Current legal review status of this annotation.",
      "type": "Dropdown",
      "group": "metadata",
      "binding": { "type": "zeebe:property", "name": "compliance_legalReview" },
      "choices": [
        { "name": "Reviewed and approved", "value": "approved" },
        { "name": "Pending legal review", "value": "pending" },
        { "name": "Not reviewed", "value": "none" }
      ],
      "value": "pending",
      "condition": { "property": "elementType", "equals": "task" }
    },

    {
      "label": "Annotator",
      "description": "Name or identifier of the person who created the annotation.",
      "type": "String",
      "group": "metadata",
      "binding": { "type": "zeebe:property", "name": "compliance_annotator" },
      "value": "",
      "condition": { "property": "elementType", "equals": "task" }
    },

    {
      "label": "Annotation Date (YYYY-MM-DD)",
      "description": "Date on which the annotation was created.",
      "type": "String",
      "group": "metadata",
      "binding": { "type": "zeebe:property", "name": "compliance_annotationDate" },
      "value": "",
      "condition": { "property": "elementType", "equals": "task" }
    },

    {
      "label": "Last Reviewed Date (YYYY-MM-DD)",
      "description": "Date of the latest legal review, if any.",
      "type": "String",
      "group": "metadata",
      "binding": { "type": "zeebe:property", "name": "compliance_lastReviewDate" },
      "value": "",
      "condition": { "property": "elementType", "equals": "task" }
    }
  ]
}