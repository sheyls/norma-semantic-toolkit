###############################################################
#  NORMA — Normative Ontology for Regulatory Machine-readable Annotations
#  Version   : 1.0
#  IRI       : https://w3id.org/norma-ontology
#              ⚠ Placeholder — replace with a dereferenceable
#                URI before publication (e.g. via w3id.org)
#  Authors   : Sheyla Leyva-Sánchez et al.
#  Licence   : CC BY 4.0
#
#  Design principle
#  ────────────────
#  The TBox is derived STRICTLY from the BPMN element template
#  (legal.compliance.deontic.v2).
#
#  Dropdown fields   → owl:Class + owl:NamedIndividual (oneOf)
#  Free-text fields  → owl:DatatypeProperty (xsd:string / xsd:date)
#  Structural roles  → owl:Class (anchors for ABox individuals)
#
#  Template field inventory
#  ────────────────────────
#  DROPDOWNS (→ TBox classes + individuals):
#    compliance_elementType    : task | exclusiveGateway
#    compliance_deonticType    : obligation | prohibition | permission
#                                | recommendation | recommendation_not | fact
#    compliance_bindingForce   : hard_law | soft_law | internal_policy | contractual
#    compliance_status         : active | under_review | disputed | superseded | pending
#    compliance_riskLevel      : critical | high | medium | low
#    compliance_extractionMethod: manual_lawyer | manual_analyst | llm
#                                 | pattern-matching | rule-based
#    compliance_legalReview    : approved | pending | none
#
#  FREE TEXT (→ data properties, ABox literals):
#    Deontic group : compliance_normStatement, compliance_deonticId (OBL|PRH|PER|REC|REC_NOT|FCT),
#                    compliance_agent, compliance_action, compliance_object,
#                    compliance_factStatement
#    Condition     : gw_conditionStatement, gw_trueBranch, gw_falseBranch,
#                    gw_crossRefs
#    Scope         : compliance_triggerCondition, compliance_jurisdiction,
#                    compliance_effectiveDate, compliance_deadline
#    Consequence   : compliance_exception, compliance_sanction,
#                    compliance_crossRefs
#    Provenance    : compliance_regulation, compliance_article,
#                    compliance_paragraph, compliance_originalText,
#                    compliance_regulationURI
#    Metadata      : compliance_confidence, compliance_annotator,
#                    compliance_annotationDate, compliance_lastReviewDate
###############################################################

@prefix norma:   <https://w3id.org/norma-ontology#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .


# =============================================================
# 0.  ONTOLOGY DECLARATION
# =============================================================

<https://w3id.org/norma-ontology>
    a owl:Ontology ;
    owl:versionIRI    <https://w3id.org/norma-ontology/1.0> ;
    owl:versionInfo   "1.0" ;
    dcterms:title     "NORMA — Normative Ontology for Regulatory Machine-readable Annotations"@en ;
    dcterms:description
        """TBox derived strictly from the BPMN compliance annotation template
        (legal.compliance.deontic.v2). Dropdown fields produce classes and
        named individuals. Free-text fields produce data properties whose
        values are populated as ABox literals by the pipeline when lawyers
        fill the template. SWRL rules and ABox content are NOT part of
        this file — they are generated per regulation pack."""@en ;
    dcterms:created   "2026-04-08"^^xsd:date ;
    dcterms:license   <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "norma" ;
    vann:preferredNamespaceUri    "https://w3id.org/norma-ontology#" .


# =============================================================
# 1.  STRUCTURAL CLASSES
# =============================================================
# These classes anchor the four structural roles implied by the
# template. Their instances are ABox individuals generated by the
# pipeline from free-text fields — no domain-specific subclasses
# are pre-defined here.
#
# Source: compliance_elementType (task → NormativeContent;
#         exclusiveGateway → LegalCondition)
#         + compliance_agent, compliance_object, compliance_regulation

norma:NormativeContent
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label   "Normative Content"@en ;
    rdfs:comment "Root class for content carried by BPMN task elements: regulative norms and constitutive rules."@en .

norma:LegalCondition
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label   "Legal Condition"@en ;
    rdfs:comment "Content carried by BPMN exclusive gateway elements: a branching legal fact or triggering condition."@en .

norma:Agent
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label   "Agent"@en ;
    rdfs:comment "The bearer of a norm — WHO must/must not/may act. Instances generated from compliance_agent."@en .

norma:LegalObject
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label   "Legal Object"@en ;
    rdfs:comment "The entity on which the prescribed action is performed — ON WHAT. Instances from compliance_object."@en .

norma:LegalSource
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label   "Legal Source"@en ;
    rdfs:comment "The legislative document from which a norm is extracted. Instances from compliance_regulation."@en .

[ a owl:AllDisjointClasses ;
  owl:members ( norma:NormativeContent norma:LegalCondition
                norma:Agent norma:LegalObject norma:LegalSource ) ] .


# =============================================================
# 2.  NORMATIVE CONTENT HIERARCHY
# =============================================================
# Source: compliance_deonticType dropdown
# Values: obligation | prohibition | permission |
#         recommendation | recommendation_not | fact

norma:RegulativeNorm
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subClassOf norma:NormativeContent ;
    rdfs:label   "Regulative Norm"@en ;
    rdfs:comment "A norm that prescribes, prohibits, or permits behaviour. Covers deonticType: obligation, prohibition, permission, recommendation, recommendation_not."@en .

norma:ConstitutiveRule
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subClassOf norma:NormativeContent ;
    rdfs:label   "Constitutive Rule"@en ;
    rdfs:comment "A rule that classifies or defines a legal concept. Covers deonticType: fact."@en .

[ a owl:AllDisjointClasses ;
  owl:members ( norma:RegulativeNorm norma:ConstitutiveRule ) ] .

norma:Obligation
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subClassOf norma:RegulativeNorm ;
    rdfs:label "Obligation"@en ;
    dcterms:identifier "OBL" ;
    rdfs:comment "Template value: obligation — MUST."@en .

norma:Prohibition
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subClassOf norma:RegulativeNorm ;
    rdfs:label "Prohibition"@en ;
    dcterms:identifier "PRH" ;
    rdfs:comment "Template value: prohibition — MUST NOT."@en .

norma:Permission
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subClassOf norma:RegulativeNorm ;
    rdfs:label "Permission"@en ;
    dcterms:identifier "PER" ;
    rdfs:comment "Template value: permission — MAY."@en .

norma:Recommendation
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subClassOf norma:RegulativeNorm ;
    rdfs:label "Recommendation"@en ;
    dcterms:identifier "REC" ;
    rdfs:comment "Template value: recommendation — SHOULD."@en .

norma:NegativeRecommendation
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subClassOf norma:RegulativeNorm ;
    rdfs:label "Negative Recommendation"@en ;
    dcterms:identifier "REC_NOT" ;
    rdfs:comment "Template value: recommendation_not — SHOULD NOT."@en .

[ a owl:AllDisjointClasses ;
  owl:members ( norma:Obligation norma:Prohibition norma:Permission
                norma:Recommendation norma:NegativeRecommendation ) ] .


# =============================================================
# 3.  CONTROLLED VOCABULARIES  (dropdown fields → closed enumerations)
# =============================================================

# ── 3.1  Binding Force  (compliance_bindingForce) ────────────

norma:BindingForce
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label   "Binding Force"@en ;
    rdfs:comment "Legal weight of a norm. Source: compliance_bindingForce."@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:oneOf ( norma:HardLaw norma:SoftLaw
                    norma:InternalPolicy norma:Contractual ) ] .

norma:HardLaw
    a owl:NamedIndividual, norma:BindingForce ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Hard Law"@en ;
    rdfs:comment "Template value: hard_law."@en .

norma:SoftLaw
    a owl:NamedIndividual, norma:BindingForce ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Soft Law"@en ;
    rdfs:comment "Template value: soft_law."@en .

norma:InternalPolicy
    a owl:NamedIndividual, norma:BindingForce ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Internal Policy"@en ;
    rdfs:comment "Template value: internal_policy."@en .

norma:Contractual
    a owl:NamedIndividual, norma:BindingForce ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Contractual Obligation"@en ;
    rdfs:comment "Template value: contractual."@en .

# ── 3.2  Norm Status  (compliance_status) ────────────────────

norma:NormStatus
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label   "Norm Status"@en ;
    rdfs:comment "Lifecycle status of a norm. Source: compliance_status."@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:oneOf ( norma:Active norma:UnderReview norma:Disputed
                    norma:Superseded norma:NotYetInForce ) ] .

norma:Active
    a owl:NamedIndividual, norma:NormStatus ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Active"@en ; rdfs:comment "Template value: active."@en .

norma:UnderReview
    a owl:NamedIndividual, norma:NormStatus ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Under Review"@en ; rdfs:comment "Template value: under_review."@en .

norma:Disputed
    a owl:NamedIndividual, norma:NormStatus ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Disputed"@en ; rdfs:comment "Template value: disputed."@en .

norma:Superseded
    a owl:NamedIndividual, norma:NormStatus ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Superseded"@en ;
    rdfs:comment "Template value: superseded. Use norma:supersededBy to link to the replacement norm."@en .

norma:NotYetInForce
    a owl:NamedIndividual, norma:NormStatus ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Not Yet In Force"@en ; rdfs:comment "Template value: pending."@en .

# ── 3.3  Risk Level  (compliance_riskLevel) ──────────────────

norma:RiskLevel
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label   "Risk Level"@en ;
    rdfs:comment "Non-compliance risk associated with a norm. Source: compliance_riskLevel."@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:oneOf ( norma:CriticalRisk norma:HighRisk
                    norma:MediumRisk norma:LowRisk ) ] .

norma:CriticalRisk  a owl:NamedIndividual, norma:RiskLevel ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Critical"@en ; rdfs:comment "Template value: critical."@en .

norma:HighRisk      a owl:NamedIndividual, norma:RiskLevel ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "High"@en ;     rdfs:comment "Template value: high."@en .

norma:MediumRisk    a owl:NamedIndividual, norma:RiskLevel ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Medium"@en ;   rdfs:comment "Template value: medium."@en .

norma:LowRisk       a owl:NamedIndividual, norma:RiskLevel ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Low"@en ;      rdfs:comment "Template value: low."@en .

# ── 3.4  Extraction Method  (compliance_extractionMethod) ─────

norma:ExtractionMethod
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label   "Extraction Method"@en ;
    rdfs:comment "How the annotation was produced. Source: compliance_extractionMethod."@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:oneOf ( norma:ManualLawyer norma:ManualAnalyst
                    norma:LLMExtraction norma:PatternMatching
                    norma:RuleBased ) ] .

norma:ManualLawyer    a owl:NamedIndividual, norma:ExtractionMethod ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Manual annotation (lawyer)"@en ;
    rdfs:comment "Template value: manual_lawyer."@en .

norma:ManualAnalyst   a owl:NamedIndividual, norma:ExtractionMethod ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Manual annotation (analyst)"@en ;
    rdfs:comment "Template value: manual_analyst."@en .

norma:LLMExtraction   a owl:NamedIndividual, norma:ExtractionMethod ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "LLM extraction"@en ;
    rdfs:comment "Template value: llm."@en .

norma:PatternMatching a owl:NamedIndividual, norma:ExtractionMethod ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Pattern matching"@en ;
    rdfs:comment "Template value: pattern-matching."@en .

norma:RuleBased       a owl:NamedIndividual, norma:ExtractionMethod ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Rule-based extraction"@en ;
    rdfs:comment "Template value: rule-based."@en .

# ── 3.5  Review Status  (compliance_legalReview) ─────────────

norma:ReviewStatus
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label   "Legal Review Status"@en ;
    rdfs:comment "Whether the annotation has been validated by legal counsel. Source: compliance_legalReview."@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:oneOf ( norma:Approved norma:PendingReview norma:NotReviewed ) ] .

norma:Approved      a owl:NamedIndividual, norma:ReviewStatus ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Reviewed and Approved"@en ;
    rdfs:comment "Template value: approved."@en .

norma:PendingReview a owl:NamedIndividual, norma:ReviewStatus ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Pending Legal Review"@en ;
    rdfs:comment "Template value: pending."@en .

norma:NotReviewed   a owl:NamedIndividual, norma:ReviewStatus ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Not Reviewed"@en ;
    rdfs:comment "Template value: none."@en .


# =============================================================
# 4.  OBJECT PROPERTIES
# =============================================================

# ── 4.1  Norm ↔ Agent  (compliance_agent) ───────────────────

norma:hasAgent
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:RegulativeNorm ;
    rdfs:range  norma:Agent ;
    rdfs:label  "has agent"@en ;
    rdfs:comment "WHO — the bearer of this norm. Individual generated from compliance_agent."@en ;
    owl:inverseOf norma:isSubjectOf .

norma:isSubjectOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:Agent ;
    rdfs:range  norma:RegulativeNorm ;
    rdfs:label  "is subject of"@en .

# SWRL serialisation shortcut — kept separate from norma:isSubjectOf
# to avoid forcing equivalence; used only in generated rule heads.
norma:performsAction
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:Agent ;
    rdfs:range  norma:RegulativeNorm ;
    rdfs:label  "performs action prescribed by"@en ;
    rdfs:comment "SWRL serialisation shortcut linking agent to norm individual in rule heads."@en .

# ── 4.2  Norm → Legal Object  (compliance_object) ────────────

norma:actsOn
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range  norma:LegalObject ;
    rdfs:label  "acts on"@en ;
    rdfs:comment "ON WHAT — the entity the action is performed on. Individual from compliance_object."@en .

# ── 4.3  Norm → controlled vocabulary values ─────────────────

norma:hasBindingForce
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:RegulativeNorm ;
    rdfs:range  norma:BindingForce ;
    rdfs:label  "has binding force"@en .

norma:hasRiskLevel
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:RegulativeNorm ;
    rdfs:range  norma:RiskLevel ;
    rdfs:label  "has risk level"@en .

norma:hasNormStatus
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range  norma:NormStatus ;
    rdfs:label  "has norm status"@en .

norma:hasExtractionMethod
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range  norma:ExtractionMethod ;
    rdfs:label  "has extraction method"@en .

norma:hasReviewStatus
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range  norma:ReviewStatus ;
    rdfs:label  "has review status"@en .

# ── 4.4  Norm → Legal Source  (compliance_regulation) ────────

norma:hasLegalSource
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range  norma:LegalSource ;
    rdfs:label  "has legal source"@en ;
    rdfs:comment "Links a norm to the regulation it was extracted from. Individual from compliance_regulation."@en ;
    owl:inverseOf norma:isSourceOf .

norma:isSourceOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:LegalSource ;
    rdfs:range  norma:NormativeContent ;
    rdfs:label  "is source of"@en .

# ── 4.5  Norm ↔ Norm  (compliance_crossRefs, gw_crossRefs) ──

norma:relatesTo
    a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range  norma:NormativeContent ;
    rdfs:label  "relates to"@en ;
    rdfs:comment "Cross-reference between norm individuals. Source: compliance_crossRefs / gw_crossRefs."@en .

norma:supersededBy
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range  norma:NormativeContent ;
    rdfs:label  "superseded by"@en ;
    rdfs:comment "Links a norm with status norma:Superseded to its replacement norm."@en .

# ── 4.6  Legal Condition → Norm  (gw_crossRefs) ──────────────

norma:triggersNorm
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:LegalCondition ;
    rdfs:range  norma:NormativeContent ;
    rdfs:label  "triggers norm"@en ;
    rdfs:comment "Links a gateway condition to the norms on its outgoing branches. Source: gw_crossRefs."@en .


# =============================================================
# 5.  DATA PROPERTIES  (free-text template fields → literals)
# =============================================================
# Every free-text field maps to exactly one data property.
# Values are populated as ABox literals by the pipeline.

# ── 5.1  Deontic group ───────────────────────────────────────

norma:normStatement
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range  xsd:string ;
    rdfs:label  "norm statement"@en ;
    rdfs:comment "Human-readable restatement of the norm. Source: compliance_normStatement."@en .

norma:deonticId
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range  xsd:string ;
    rdfs:label  "deontic ID"@en ;
    rdfs:comment "Unique norm identifier within the regulation pack. Pattern: OBL_xxx | PRH_xxx | PER_xxx | REC_xxx | REC_NOT_xxx | FCT_xxx. Source: compliance_deonticId."@en .

norma:agent
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:RegulativeNorm ;
    rdfs:range  xsd:string ;
    rdfs:label  "agent (label)"@en ;
    rdfs:comment "Raw string label of the agent as entered in the template. Used by the pipeline to mint or look up the Agent individual. Source: compliance_agent."@en .

norma:action
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:RegulativeNorm ;
    rdfs:range  xsd:string ;
    rdfs:label  "action"@en ;
    rdfs:comment "Verb phrase describing WHAT must/must not/may be done. Source: compliance_action."@en .

norma:object
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:RegulativeNorm ;
    rdfs:range  xsd:string ;
    rdfs:label  "object (label)"@en ;
    rdfs:comment "Raw string label of the legal object as entered in the template. Used by the pipeline to mint or look up the LegalObject individual. Source: compliance_object."@en .

norma:factStatement
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:ConstitutiveRule ;
    rdfs:range  xsd:string ;
    rdfs:label  "fact statement"@en ;
    rdfs:comment "The constitutive classification or legal definition in plain text. Source: compliance_factStatement."@en .

# ── 5.2  Condition / Gateway group ───────────────────────────

norma:conditionStatement
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:LegalCondition ;
    rdfs:range  xsd:string ;
    rdfs:label  "condition statement"@en ;
    rdfs:comment "Plain-language question evaluated at this gateway. Source: gw_conditionStatement."@en .

norma:trueBranchLabel
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:LegalCondition ;
    rdfs:range  xsd:string ;
    rdfs:label  "true branch label"@en ;
    rdfs:comment "Display label when condition is met (e.g. 'Yes'). Source: gw_trueBranch."@en .

norma:falseBranchLabel
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:LegalCondition ;
    rdfs:range  xsd:string ;
    rdfs:label  "false branch label"@en ;
    rdfs:comment "Display label when condition is not met (e.g. 'No'). Source: gw_falseBranch."@en .

norma:crossRefsGateway
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:LegalCondition ;
    rdfs:range  xsd:string ;
    rdfs:label  "gateway cross-references"@en ;
    rdfs:comment "Comma-separated deontic IDs triggered by this condition. Source: gw_crossRefs. Parsed by pipeline into norma:triggersNorm object property assertions."@en .

# ── 5.3  Scope group ─────────────────────────────────────────

norma:conditionTrigger
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:RegulativeNorm ;
    rdfs:range  xsd:string ;
    rdfs:label  "trigger condition"@en ;
    rdfs:comment "Free-text description of when this norm applies. Human-readable only; not parsed into SWRL bodies. Restricted to regulative norms — constitutive facts do not have trigger conditions. Source: compliance_triggerCondition."@en .

norma:jurisdiction
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range  xsd:string ;
    rdfs:label  "jurisdiction"@en ;
    rdfs:comment "Geographic or legal scope (e.g. EU, US-CA, UK, global). Source: compliance_jurisdiction."@en .

norma:effectiveDate
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range  xsd:date ;
    rdfs:label  "effective date"@en ;
    rdfs:comment "Source: compliance_effectiveDate (YYYY-MM-DD)."@en .

norma:deadline
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range  xsd:date ;
    rdfs:label  "deadline / sunset date"@en ;
    rdfs:comment "Source: compliance_deadline (YYYY-MM-DD)."@en .

# ── 5.4  Consequence group ───────────────────────────────────

norma:exception
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:RegulativeNorm ;
    rdfs:range  xsd:string ;
    rdfs:label  "exception / carve-out"@en ;
    rdfs:comment "Conditions under which this norm does NOT apply. Free text; formal negation handled by DDL layer. Source: compliance_exception."@en .

norma:sanction
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:RegulativeNorm ;
    rdfs:range  xsd:string ;
    rdfs:label  "sanction"@en ;
    rdfs:comment "Consequence of breaching this norm. Source: compliance_sanction."@en .

norma:crossRefsNorm
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range  xsd:string ;
    rdfs:label  "norm cross-references"@en ;
    rdfs:comment "Comma-separated deontic IDs of related norms. Source: compliance_crossRefs. Parsed by pipeline into norma:relatesTo object property assertions."@en .

# ── 5.5  Provenance group  (legalSource fields) ──────────────

norma:regulationName
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:LegalSource ;
    rdfs:range  xsd:string ;
    rdfs:label  "regulation name"@en ;
    rdfs:comment "Name of the source regulation (e.g. 'EU AI Act', 'GDPR'). Source: compliance_regulation."@en .

norma:articleNumber
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:LegalSource ;
    rdfs:range  xsd:string ;
    rdfs:label  "article number"@en ;
    rdfs:comment "Article or section number within the source document. Source: compliance_article."@en .

norma:paragraphNumber
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:LegalSource ;
    rdfs:range  xsd:string ;
    rdfs:label  "paragraph number"@en ;
    rdfs:comment "Paragraph or subsection within the article. Source: compliance_paragraph."@en .

norma:originalText
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:LegalSource ;
    rdfs:range  xsd:string ;
    rdfs:label  "original legal text"@en ;
    rdfs:comment "Verbatim quote from the source legislative text for traceability. Source: compliance_originalText."@en .

norma:regulationURI
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:LegalSource ;
    rdfs:range  xsd:anyURI ;
    rdfs:label  "regulation URI"@en ;
    rdfs:comment "Dereferenceable URI of the source document (ELI-compatible). Source: compliance_regulationURI."@en .

# SWRL shortcut copies of provenance on NormativeContent
# Required because DL-safe rule heads cannot traverse object property chains.
# Values are denormalised copies of the above, populated by the pipeline.

norma:fromRegulation
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range  xsd:string ;
    rdfs:label  "from regulation"@en ;
    rdfs:comment "SWRL shortcut — denormalised copy of norma:regulationName for use in rule heads."@en .

norma:fromArticle
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range  xsd:string ;
    rdfs:label  "from article"@en ;
    rdfs:comment "SWRL shortcut — denormalised copy of norma:articleNumber for use in rule heads."@en .

norma:fromParagraph
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range  xsd:string ;
    rdfs:label  "from paragraph"@en ;
    rdfs:comment "SWRL shortcut — denormalised copy of norma:paragraphNumber for use in rule heads."@en .

norma:sourceURI
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range  xsd:anyURI ;
    rdfs:label  "source URI"@en ;
    rdfs:comment "SWRL shortcut — denormalised copy of norma:regulationURI for use in rule heads."@en .

# ── 5.6  Annotation metadata group ───────────────────────────

norma:confidenceScore
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range  xsd:decimal ;
    rdfs:label  "confidence score"@en ;
    rdfs:comment "Annotator certainty in [0.0, 1.0]. Values below 0.7 trigger mandatory legal review. Source: compliance_confidence."@en .

norma:annotator
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range  xsd:string ;
    rdfs:label  "annotator"@en ;
    rdfs:comment "Name or identifier of the person who created this annotation. Source: compliance_annotator."@en .

norma:annotationDate
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range  xsd:date ;
    rdfs:label  "annotation date"@en ;
    rdfs:comment "Source: compliance_annotationDate (YYYY-MM-DD)."@en .

norma:lastReviewDate
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range  xsd:date ;
    rdfs:label  "last reviewed date"@en ;
    rdfs:comment "Source: compliance_lastReviewDate (YYYY-MM-DD)."@en .


# =============================================================
# 6.  SWRL INTERFACE NOTE
# =============================================================
# Properties used as atoms in generated DL-safe SWRL rules:
#
# Rule BODY (DataPropertyAtom — from gateway annotations):
#   norma:conditionStatement   LegalCondition  "..."^^xsd:string
#   (pipeline derives a boolean ABox property per condition)
#
# Rule HEAD (from task annotations):
#   ObjectPropertyAtom  norma:performsAction   AgentIndividual  NormIndividual
#   ObjectPropertyAtom  norma:actsOn           NormIndividual   ObjectIndividual
#   ObjectPropertyAtom  norma:hasBindingForce  NormIndividual   norma:HardLaw
#   ObjectPropertyAtom  norma:hasRiskLevel     NormIndividual   norma:HighRisk
#   DataPropertyAtom    norma:fromRegulation   NormIndividual   "EU AI Act"
#   DataPropertyAtom    norma:fromArticle      NormIndividual   "50"
#   DataPropertyAtom    norma:fromParagraph    NormIndividual   "2"
#   DataPropertyAtom    norma:sourceURI        NormIndividual   <uri>
#   DataPropertyAtom    norma:sanction         NormIndividual   "..."
#   DataPropertyAtom    norma:confidenceScore  NormIndividual   "0.95"^^xsd:decimal
# =============================================================
