@prefix norma:   <https://w3id.org/norma-ontology#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix eli:     <http://data.europa.eu/eli/ontology#> .
@prefix time:    <http://www.w3.org/2006/time#> .
@prefix org:     <http://www.w3.org/ns/org#> .

#################################################################
# 0. ONTOLOGY DECLARATION
#################################################################

<https://w3id.org/norma-ontology>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/norma-ontology/1.0> ;
    owl:versionInfo "1.0" ;
    dcterms:title "NORMA — Normative Ontology for Regulatory Machine-readable Annotations"@en ;
    dcterms:alternative "NORMA Ontology"@en ;
    dcterms:description """Ontology for representing machine-readable legal compliance annotations derived from BPMN element templates in the NORMA pipeline. The ontology models normative content, deontic modalities, legal conditions, legal sources, legal agents, legal actions, legal objects, provenance metadata, and temporal validity for compliance processing."""@en ;
    dcterms:created "2026-04-15"^^xsd:date ;
    dcterms:modified "2026-04-15"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:publisher "NORMA project"@en ;
    dcterms:creator "Sheyla Leyva-Sánchez et al."@en ;
    vann:preferredNamespacePrefix "norma" ;
    vann:preferredNamespaceUri "https://w3id.org/norma-ontology#" ;
    rdfs:label "NORMA ontology"@en ;
    rdfs:comment "Publication-quality ontology aligned to the NORMA annotation model and BPMN legal compliance workflow."@en .

#################################################################
# 1. CORE CLASSES
#################################################################

norma:NormativeContent
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Normative Content"@en ;
    rdfs:comment "An informational entity that expresses machine-readable legal-normative content extracted or formulated from a legal source, including either a regulative norm or a constitutive rule."@en .

norma:LegalCondition
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Legal Condition"@en ;
    rdfs:comment "A legally relevant condition, fact pattern, or decision criterion whose satisfaction determines whether normative content becomes applicable or is triggered."@en .

norma:LegalSource
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subClassOf eli:LegalResource ;
    rdfs:label "Legal Source"@en ;
    rdfs:comment "A legal resource from which normative content is extracted, cited, or traced."@en .

norma:LegalSourceExpression
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subClassOf eli:LegalExpression ;
    rdfs:label "Legal Source Expression"@en ;
    rdfs:comment "A concrete legal expression of a legal source, such as a specific language, version, or published expression of the legal resource."@en .

norma:RegulativeNorm
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subClassOf norma:NormativeContent ;
    rdfs:label "Regulative Norm"@en ;
    rdfs:comment "A normative content item that regulates conduct by prescribing, prohibiting, permitting, or recommending a legal action."@en .

norma:ConstitutiveRule
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subClassOf norma:NormativeContent ;
    rdfs:label "Constitutive Rule"@en ;
    rdfs:comment "A normative content item that defines, classifies, or constitutes a legal concept, status, or institutional fact."@en .

norma:LegalAgent
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Legal Agent"@en ;
    rdfs:comment "An entity that bears the legally relevant role of subject of a regulative norm, that is, the party that is obliged, prohibited, permitted, or recommended to perform a legal action."@en .

norma:OrganizationalLegalAgent
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subClassOf norma:LegalAgent , org:Organization ;
    rdfs:label "Organizational Legal Agent"@en ;
    rdfs:comment "A legal agent that is also an organization in the sense of the W3C Organization Ontology."@en .

norma:LegalAction
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Legal Action"@en ;
    rdfs:comment "A normalized legal action that is prescribed, prohibited, permitted, or recommended by a regulative norm."@en .

norma:LegalObject
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Legal Object"@en ;
    rdfs:comment "The entity, resource, person, document, system, content, or data item toward which the regulated action is directed."@en .

norma:TemporalValidity
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subClassOf time:Interval ;
    rdfs:label "Temporal Validity"@en ;
    rdfs:comment "A temporal interval representing the validity or applicability period of normative content."@en .

#################################################################
# 1.1 PROVENANCE CLASSES
#################################################################

norma:AnnotationActivity
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Annotation Activity"@en ;
    rdfs:comment "A provenance activity that produces or modifies a normative annotation."@en .

norma:ExtractionActivity
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subClassOf norma:AnnotationActivity ;
    rdfs:label "Extraction Activity"@en ;
    rdfs:comment "An annotation activity that extracts normative content from a legal source."@en .

norma:ReviewActivity
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subClassOf norma:AnnotationActivity ;
    rdfs:label "Review Activity"@en ;
    rdfs:comment "An annotation activity that reviews or validates normative content."@en .

[ a owl:AllDisjointClasses ;
  owl:members (
    norma:NormativeContent
    norma:LegalCondition
    norma:LegalSource
    norma:LegalAction
  )
] .

norma:RegulativeNorm owl:disjointWith norma:ConstitutiveRule .

#################################################################
# 2. DEONTIC HIERARCHY
#################################################################

norma:Obligation
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subClassOf norma:RegulativeNorm ;
    dcterms:identifier "OBL" ;
    rdfs:label "Obligation"@en ;
    rdfs:comment "A regulative norm stating that a legal action is required."@en .

norma:Prohibition
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subClassOf norma:RegulativeNorm ;
    dcterms:identifier "PRH" ;
    rdfs:label "Prohibition"@en ;
    rdfs:comment "A regulative norm stating that a legal action is forbidden."@en .

norma:Permission
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subClassOf norma:RegulativeNorm ;
    dcterms:identifier "PER" ;
    rdfs:label "Permission"@en ;
    rdfs:comment "A regulative norm stating that a legal action is allowed."@en .

norma:Recommendation
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subClassOf norma:RegulativeNorm ;
    dcterms:identifier "REC" ;
    rdfs:label "Recommendation"@en ;
    rdfs:comment "A regulative norm stating that a legal action is recommended."@en .

norma:NegativeRecommendation
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subClassOf norma:RegulativeNorm ;
    dcterms:identifier "REC_NOT" ;
    rdfs:label "Negative Recommendation"@en ;
    rdfs:comment "A regulative norm stating that a legal action is discouraged."@en .

[ a owl:AllDisjointClasses ;
  owl:members (
    norma:Obligation
    norma:Prohibition
    norma:Permission
    norma:Recommendation
    norma:NegativeRecommendation
  )
] .

#################################################################
# 3. CONTROLLED VOCABULARIES
#################################################################

### 3.1 Norm status

norma:NormStatus
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Norm Status"@en ;
    rdfs:comment "Lifecycle status of a normative content item."@en ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf (
            norma:Active
            norma:UnderReview
            norma:Disputed
            norma:Superseded
            norma:NotYetInForce
        )
    ] .

norma:Active
    a owl:NamedIndividual, norma:NormStatus ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Active"@en ;
    rdfs:comment "Currently in force or active."@en .

norma:UnderReview
    a owl:NamedIndividual, norma:NormStatus ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Under Review"@en ;
    rdfs:comment "Under legal, editorial, or analytical review."@en .

norma:Disputed
    a owl:NamedIndividual, norma:NormStatus ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Disputed"@en ;
    rdfs:comment "Legally or interpretively disputed."@en .

norma:Superseded
    a owl:NamedIndividual, norma:NormStatus ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Superseded"@en ;
    rdfs:comment "Replaced by another norm."@en .

norma:NotYetInForce
    a owl:NamedIndividual, norma:NormStatus ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Not Yet In Force"@en ;
    rdfs:comment "Published or known but not yet effective."@en .

### 3.2 Compliance criticality

norma:ComplianceCriticality
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Compliance Criticality"@en ;
    rdfs:comment "Criticality level associated with non-compliance with a regulative norm."@en ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf (
            norma:Critical
            norma:High
            norma:Medium
            norma:Low
        )
    ] .

norma:Critical
    a owl:NamedIndividual, norma:ComplianceCriticality ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Critical"@en .

norma:High
    a owl:NamedIndividual, norma:ComplianceCriticality ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "High"@en .

norma:Medium
    a owl:NamedIndividual, norma:ComplianceCriticality ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Medium"@en .

norma:Low
    a owl:NamedIndividual, norma:ComplianceCriticality ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Low"@en .

### 3.3 Extraction method

norma:ExtractionMethod
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Extraction Method"@en ;
    rdfs:comment "Method used to produce the annotation."@en ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf (
            norma:ManualLawyer
            norma:ManualAnalyst
            norma:LLMExtraction
            norma:PatternMatching
            norma:RuleBased
        )
    ] .

norma:ManualLawyer
    a owl:NamedIndividual, norma:ExtractionMethod ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Manual annotation (lawyer)"@en .

norma:ManualAnalyst
    a owl:NamedIndividual, norma:ExtractionMethod ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Manual annotation (analyst)"@en .

norma:LLMExtraction
    a owl:NamedIndividual, norma:ExtractionMethod ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "LLM extraction"@en .

norma:PatternMatching
    a owl:NamedIndividual, norma:ExtractionMethod ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Pattern matching"@en .

norma:RuleBased
    a owl:NamedIndividual, norma:ExtractionMethod ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Rule-based extraction"@en .

### 3.4 Review status

norma:ReviewStatus
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Review Status"@en ;
    rdfs:comment "Legal review status of an annotation."@en ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf (
            norma:Approved
            norma:PendingReview
            norma:NotReviewed
        )
    ] .

norma:Approved
    a owl:NamedIndividual, norma:ReviewStatus ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Approved"@en .

norma:PendingReview
    a owl:NamedIndividual, norma:ReviewStatus ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Pending Review"@en .

norma:NotReviewed
    a owl:NamedIndividual, norma:ReviewStatus ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Not Reviewed"@en .

### 3.5 Binding force

norma:BindingForce
    a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Binding Force"@en ;
    rdfs:comment "Binding force of a norm."@en ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf (
            norma:HardLaw
            norma:SoftLaw
            norma:InternalPolicy
            norma:Contractual
        )
    ] .

norma:HardLaw
    a owl:NamedIndividual, norma:BindingForce ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Hard Law"@en .

norma:SoftLaw
    a owl:NamedIndividual, norma:BindingForce ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Soft Law"@en .

norma:InternalPolicy
    a owl:NamedIndividual, norma:BindingForce ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Internal Policy"@en .

norma:Contractual
    a owl:NamedIndividual, norma:BindingForce ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:label "Contractual"@en .

#################################################################
# 4. OBJECT PROPERTIES
#################################################################

norma:hasLegalAgent
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:RegulativeNorm ;
    rdfs:range norma:LegalAgent ;
    rdfs:label "has legal agent"@en ;
    rdfs:comment "Links a regulative norm to its norm-bearing legal agent."@en ;
    owl:inverseOf norma:isLegalAgentOf .

norma:isLegalAgentOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:LegalAgent ;
    rdfs:range norma:RegulativeNorm ;
    rdfs:label "is legal agent of"@en ;
    rdfs:comment "Inverse of hasLegalAgent."@en .

norma:hasAction
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:RegulativeNorm ;
    rdfs:range norma:LegalAction ;
    rdfs:label "has action"@en ;
    rdfs:comment "Links a regulative norm to the legal action it regulates."@en ;
    owl:inverseOf norma:isActionOf .

norma:isActionOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:LegalAction ;
    rdfs:range norma:RegulativeNorm ;
    rdfs:label "is action of"@en ;
    rdfs:comment "Inverse of hasAction."@en .

norma:hasObject
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:RegulativeNorm ;
    rdfs:range norma:LegalObject ;
    rdfs:label "has object"@en ;
    rdfs:comment "Links a regulative norm to the legal object of the action it regulates."@en ;
    owl:inverseOf norma:isObjectOf .

norma:isObjectOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:LegalObject ;
    rdfs:range norma:RegulativeNorm ;
    rdfs:label "is object of"@en ;
    rdfs:comment "Inverse of hasObject."@en .

norma:hasLegalSource
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range norma:LegalSource ;
    rdfs:label "has legal source"@en ;
    rdfs:comment "Links normative content to the legal source from which it is extracted."@en ;
    owl:inverseOf norma:isSourceOf .

norma:isSourceOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:LegalSource ;
    rdfs:range norma:NormativeContent ;
    rdfs:label "is source of"@en ;
    rdfs:comment "Inverse of hasLegalSource."@en .

norma:hasSourceExpression
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range norma:LegalSourceExpression ;
    rdfs:label "has source expression"@en ;
    rdfs:comment "Links normative content to a specific legal expression of the source resource, such as a language or version-specific expression."@en .

### PROV-O integrations

norma:wasAttributedToAnnotator
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range prov:Agent ;
    rdfs:label "was attributed to annotator"@en ;
    rdfs:comment "Links normative content to the provenance agent responsible for its annotation."@en .

norma:wasReviewedBy
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subPropertyOf prov:wasAssociatedWith ;
    rdfs:domain norma:ReviewActivity ;
    rdfs:range prov:Agent ;
    rdfs:label "was reviewed by"@en ;
    rdfs:comment "Links a review activity to the provenance agent responsible for carrying it out."@en .

norma:wasGeneratedByAnnotationActivity
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subPropertyOf prov:wasGeneratedBy ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range norma:AnnotationActivity ;
    rdfs:label "was generated by annotation activity"@en ;
    rdfs:comment "Links normative content to the annotation activity that generated it."@en .

norma:usedLegalSource
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain norma:AnnotationActivity ;
    rdfs:range norma:LegalSource ;
    rdfs:label "used legal source"@en ;
    rdfs:comment "Links an annotation activity to the legal source it used."@en .

norma:wasDerivedFromSource
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range norma:LegalSource ;
    rdfs:label "was derived from source"@en ;
    rdfs:comment "Links normative content to the legal source from which it was derived."@en .

norma:generatedAtTime
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:subPropertyOf prov:generatedAtTime ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range xsd:dateTime ;
    rdfs:label "generated at time"@en ;
    rdfs:comment "Timestamp at which the normative content was generated as an annotation artifact."@en .

norma:hasNormStatus
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range norma:NormStatus ;
    rdfs:label "has norm status"@en ;
    rdfs:comment "Associates a normative content item with one lifecycle status."@en .

norma:hasComplianceCriticality
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:RegulativeNorm ;
    rdfs:range norma:ComplianceCriticality ;
    rdfs:label "has compliance criticality"@en ;
    rdfs:comment "Associates a regulative norm with one compliance criticality value."@en .

norma:hasExtractionMethod
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range norma:ExtractionMethod ;
    rdfs:label "has extraction method"@en ;
    rdfs:comment "Associates a normative content item with the method used to produce its annotation."@en .

norma:hasReviewStatus
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range norma:ReviewStatus ;
    rdfs:label "has review status"@en ;
    rdfs:comment "Associates a normative content item with one review status."@en .

norma:hasBindingForce
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:RegulativeNorm ;
    rdfs:range norma:BindingForce ;
    rdfs:label "has binding force"@en ;
    rdfs:comment "Associates a regulative norm with one binding-force value."@en .

norma:triggersNorm
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:LegalCondition ;
    rdfs:range norma:NormativeContent ;
    rdfs:label "triggers norm"@en ;
    rdfs:comment "Links a legal condition to the normative content it triggers."@en .

norma:relatesTo
    a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range norma:NormativeContent ;
    rdfs:label "relates to"@en ;
    rdfs:comment "Associates one normative content item with another related one."@en .

norma:supersededBy
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range norma:NormativeContent ;
    rdfs:label "superseded by"@en ;
    rdfs:comment "Links a superseded normative content item to the item that replaces it."@en .

### OWL-Time integrations

norma:hasTemporalValidity
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range norma:TemporalValidity ;
    rdfs:label "has temporal validity"@en ;
    rdfs:comment "Links normative content to the interval during which it is valid or applicable."@en .

norma:hasEffectiveTime
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range time:Instant ;
    rdfs:label "has effective time"@en ;
    rdfs:comment "Links normative content to the instant at which it becomes effective."@en .

norma:hasDeadlineTime
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range time:Instant ;
    rdfs:label "has deadline time"@en ;
    rdfs:comment "Links normative content to the instant representing its deadline or sunset time."@en .

norma:hasAnnotationTime
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range time:Instant ;
    rdfs:label "has annotation time"@en ;
    rdfs:comment "Links normative content to the instant at which the annotation was created."@en .

norma:hasLastReviewTime
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range time:Instant ;
    rdfs:label "has last review time"@en ;
    rdfs:comment "Links normative content to the instant of its latest review."@en .

#################################################################
# 5. DATATYPE PROPERTIES
#################################################################

### 5.1 Normative content

norma:normStatement
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range xsd:string ;
    rdfs:label "norm statement"@en ;
    rdfs:comment "Human-readable restatement of the norm or rule."@en .

norma:deonticId
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range xsd:string ;
    rdfs:label "deontic ID"@en ;
    rdfs:comment "Unique identifier for a norm or constitutive rule within the regulation pack."@en .

norma:jurisdiction
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range xsd:string ;
    rdfs:label "jurisdiction"@en ;
    rdfs:comment "Jurisdiction or legal scope of the normative content."@en .

norma:effectiveDate
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range xsd:date ;
    rdfs:label "effective date"@en ;
    rdfs:comment "Convenience literal for the date from which the normative content is effective."@en .

norma:deadline
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range xsd:date ;
    rdfs:label "deadline"@en ;
    rdfs:comment "Convenience literal for the deadline, sunset date, or end date associated with the normative content."@en .

norma:crossRefsNorm
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range xsd:string ;
    rdfs:label "cross references (norm)"@en ;
    rdfs:comment "Raw textual cross-references to related norms."@en .

norma:fromRegulation
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range xsd:string ;
    rdfs:label "from regulation"@en ;
    rdfs:comment "Denormalized regulation name copied from the legal source for convenient querying or rule generation."@en .

norma:fromArticle
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range xsd:string ;
    rdfs:label "from article"@en ;
    rdfs:comment "Denormalized article identifier copied from the legal source."@en .

norma:fromParagraph
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range xsd:string ;
    rdfs:label "from paragraph"@en ;
    rdfs:comment "Denormalized paragraph identifier copied from the legal source."@en .

norma:sourceURI
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range xsd:anyURI ;
    rdfs:label "source URI"@en ;
    rdfs:comment "Denormalized URI copied from the linked legal source."@en .

norma:confidenceScore
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range xsd:decimal ;
    rdfs:label "confidence score"@en ;
    rdfs:comment "Confidence score for the annotation, usually in the range [0,1]."@en .

norma:annotator
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range xsd:string ;
    rdfs:label "annotator"@en ;
    rdfs:comment "Name or identifier of the annotator, retained as a convenience literal."@en .

norma:annotationDate
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range xsd:date ;
    rdfs:label "annotation date"@en ;
    rdfs:comment "Convenience literal for the date on which the annotation was created."@en .

norma:lastReviewDate
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:NormativeContent ;
    rdfs:range xsd:date ;
    rdfs:label "last review date"@en ;
    rdfs:comment "Convenience literal for the date of the latest legal or editorial review."@en .

### 5.2 Regulative norms

norma:agentText
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:RegulativeNorm ;
    rdfs:range xsd:string ;
    rdfs:label "agent text"@en ;
    rdfs:comment "Raw textual form of the legal agent as entered in the annotation template."@en .

norma:actionText
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:RegulativeNorm ;
    rdfs:range xsd:string ;
    rdfs:label "action text"@en ;
    rdfs:comment "Raw textual form of the regulated action as entered in the annotation template."@en .

norma:objectText
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:RegulativeNorm ;
    rdfs:range xsd:string ;
    rdfs:label "object text"@en ;
    rdfs:comment "Raw textual form of the legal object as entered in the annotation template."@en .

norma:conditionTrigger
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:RegulativeNorm ;
    rdfs:range xsd:string ;
    rdfs:label "condition trigger"@en ;
    rdfs:comment "Raw textual description of the condition under which the norm applies."@en .

norma:exception
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:RegulativeNorm ;
    rdfs:range xsd:string ;
    rdfs:label "exception"@en ;
    rdfs:comment "Exception or carve-out under which the norm does not apply."@en .

norma:sanction
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:RegulativeNorm ;
    rdfs:range xsd:string ;
    rdfs:label "sanction"@en ;
    rdfs:comment "Sanction or consequence associated with non-compliance."@en .

### 5.3 Constitutive rules

norma:factStatement
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:ConstitutiveRule ;
    rdfs:range xsd:string ;
    rdfs:label "fact statement"@en ;
    rdfs:comment "Plain-language statement of the constitutive rule."@en .

### 5.4 Legal conditions

norma:conditionStatement
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:LegalCondition ;
    rdfs:range xsd:string ;
    rdfs:label "condition statement"@en ;
    rdfs:comment "Plain-language formulation of the legal condition evaluated at a gateway."@en .

norma:trueBranchLabel
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:LegalCondition ;
    rdfs:range xsd:string ;
    rdfs:label "true branch label"@en ;
    rdfs:comment "Label of the outgoing branch when the condition holds."@en .

norma:falseBranchLabel
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:LegalCondition ;
    rdfs:range xsd:string ;
    rdfs:label "false branch label"@en ;
    rdfs:comment "Label of the outgoing branch when the condition does not hold."@en .

norma:crossRefsGateway
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:LegalCondition ;
    rdfs:range xsd:string ;
    rdfs:label "cross references (gateway)"@en ;
    rdfs:comment "Raw textual references to the norms triggered by the legal condition."@en .

### 5.5 Legal sources

norma:regulationName
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:LegalSource ;
    rdfs:range xsd:string ;
    rdfs:label "regulation name"@en ;
    rdfs:comment "Name of the legal or regulatory source."@en .

norma:articleNumber
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:LegalSource ;
    rdfs:range xsd:string ;
    rdfs:label "article number"@en ;
    rdfs:comment "Article, section, or equivalent unit number. Not functional: a single LegalSource may cover multiple articles."@en .

norma:paragraphNumber
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:LegalSource ;
    rdfs:range xsd:string ;
    rdfs:label "paragraph number"@en ;
    rdfs:comment "Paragraph, subsection, or equivalent granular locator. Not functional: a single LegalSource may have multiple paragraphs."@en .

norma:originalText
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:LegalSource ;
    rdfs:range xsd:string ;
    rdfs:label "original text"@en ;
    rdfs:comment "Verbatim legal text from the legal source."@en .

norma:regulationURI
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/norma-ontology> ;
    rdfs:domain norma:LegalSource ;
    rdfs:range xsd:anyURI ;
    rdfs:label "regulation URI"@en ;
    rdfs:comment "URI identifying the legal source."@en .