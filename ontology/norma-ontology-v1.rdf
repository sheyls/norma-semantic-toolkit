	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#Permission">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Template value: permission — MAY.</comment>
		<identifier xmlns="http://purl.org/dc/terms/">PER</identifier>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Permission</label>
