	<rdf:Description rdf:about="https://w3id.org/norma-ontology#agent">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Raw string label of the agent as entered in the template. Used by the pipeline to mint or look up the Agent individual. Source: compliance_agent.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">agent (label)</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
