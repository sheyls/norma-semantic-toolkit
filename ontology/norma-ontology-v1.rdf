	<rdf:Description rdf:about="https://w3id.org/norma-ontology#NegativeRecommendation">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A regulative norm stating that a legal action is discouraged.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Negative Recommendation</label>
		<identifier xmlns="http://purl.org/dc/terms/">REC_NOT</identifier>
		<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#RegulativeNorm"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#Recommendation">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A regulative norm stating that a legal action is recommended.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Recommendation</label>
		<identifier xmlns="http://purl.org/dc/terms/">REC</identifier>
		<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#RegulativeNorm"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#Permission">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A regulative norm stating that a legal action is allowed.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Permission</label>
		<identifier xmlns="http://purl.org/dc/terms/">PER</identifier>
		<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#RegulativeNorm"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#Prohibition">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A regulative norm stating that a legal action is forbidden.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Prohibition</label>
		<identifier xmlns="http://purl.org/dc/terms/">PRH</identifier>
		<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#RegulativeNorm"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#Obligation">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A regulative norm stating that a legal action is required.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Obligation</label>
		<identifier xmlns="http://purl.org/dc/terms/">OBL</identifier>
		<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#RegulativeNorm"/>
