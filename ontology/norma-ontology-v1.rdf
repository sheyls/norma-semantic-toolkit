	<rdf:Description rdf:about="https://w3id.org/norma-ontology#LegalSource">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The legislative document from which a norm is extracted. Instances from compliance_regulation.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Legal Source</label>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#LegalObject">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The entity on which the prescribed action is performed — ON WHAT. Instances from compliance_object.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Legal Object</label>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#Agent">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The bearer of a norm — WHO must/must not/may act. Instances generated from compliance_agent.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Agent</label>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#LegalCondition">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Content carried by BPMN exclusive gateway elements: a branching legal fact or triggering condition.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Legal Condition</label>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#NormativeContent">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Root class for content carried by BPMN task elements: regulative norms and constitutive rules.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Normative Content</label>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology">
		<preferredNamespaceUri xmlns="http://purl.org/vocab/vann/">https://w3id.org/norma-ontology#</preferredNamespaceUri>
		<preferredNamespacePrefix xmlns="http://purl.org/vocab/vann/">norma</preferredNamespacePrefix>
		<license xmlns="http://purl.org/dc/terms/" rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
		<created xmlns="http://purl.org/dc/terms/" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-08</created>
		<description xmlns="http://purl.org/dc/terms/" xml:lang="en">TBox derived strictly from the BPMN compliance annotation template
        (legal.compliance.deontic.v2). Dropdown fields produce classes and
        named individuals. Free-text fields produce data properties whose
        values are populated as ABox literals by the pipeline when lawyers
        fill the template. SWRL rules and ABox content are NOT part of
        this file — they are generated per regulation pack.</description>
		<title xmlns="http://purl.org/dc/terms/" xml:lang="en">NORMA — Normative Ontology for Regulatory Machine-readable Annotations</title>
		<versionInfo xmlns="http://www.w3.org/2002/07/owl#">1.0</versionInfo>
		<versionIRI xmlns="http://www.w3.org/2002/07/owl#" rdf:resource="https://w3id.org/norma-ontology/1.0"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
	</rdf:Description>
</rdf:RDF>