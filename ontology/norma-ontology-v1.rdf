	<rdf:Description rdf:about="https://w3id.org/norma-ontology#supersededBy">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a norm with status norma:Superseded to its replacement norm.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">superseded by</label>
