<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:its="http://www.w3.org/2005/11/its">
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#regulationURI">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">URI identifying the legal source.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">regulation URI</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#LegalSource"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#originalText">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Verbatim legal text from the legal source.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">original text</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#LegalSource"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#paragraphNumber">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Paragraph, subsection, or equivalent granular locator. Not functional: a single LegalSource may have multiple paragraphs.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">paragraph number</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#LegalSource"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#articleNumber">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Article, section, or equivalent unit number. Not functional: a single LegalSource may cover multiple articles.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">article number</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#LegalSource"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#regulationName">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Name of the legal or regulatory source.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">regulation name</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#LegalSource"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#crossRefsGateway">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Raw textual references to the norms triggered by the legal condition.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">cross references (gateway)</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#LegalCondition"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#falseBranchLabel">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Label of the outgoing branch when the condition does not hold.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">false branch label</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#LegalCondition"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#trueBranchLabel">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Label of the outgoing branch when the condition holds.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">true branch label</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#LegalCondition"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#conditionStatement">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Plain-language formulation of the legal condition evaluated at a gateway.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">condition statement</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#LegalCondition"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#factStatement">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Plain-language statement of the constitutive rule.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">fact statement</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#ConstitutiveRule"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#sanction">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Sanction or consequence associated with non-compliance.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">sanction</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#RegulativeNorm"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#exception">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Exception or carve-out under which the norm does not apply.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">exception</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#RegulativeNorm"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#conditionTrigger">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Raw textual description of the condition under which the norm applies.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">condition trigger</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#RegulativeNorm"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#objectText">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Raw textual form of the legal object as entered in the annotation template.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">object text</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#RegulativeNorm"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#actionText">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Raw textual form of the regulated action as entered in the annotation template.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">action text</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#RegulativeNorm"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#agentText">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Raw textual form of the legal agent as entered in the annotation template.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">agent text</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#RegulativeNorm"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#lastReviewDate">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Convenience literal for the date of the latest legal or editorial review.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">last review date</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#annotationDate">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Convenience literal for the date on which the annotation was created.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">annotation date</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#annotator">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Name or identifier of the annotator, retained as a convenience literal.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">annotator</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#confidenceScore">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Confidence score for the annotation, usually in the range [0,1].</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">confidence score</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#sourceURI">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Denormalized URI copied from the linked legal source.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">source URI</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#fromParagraph">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Denormalized paragraph identifier copied from the legal source.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">from paragraph</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#fromArticle">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Denormalized article identifier copied from the legal source.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">from article</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#fromRegulation">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Denormalized regulation name copied from the legal source for convenient querying or rule generation.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">from regulation</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#crossRefsNorm">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Raw textual cross-references to related norms.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">cross references (norm)</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#deadline">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Convenience literal for the deadline, sunset date, or end date associated with the normative content.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">deadline</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#effectiveDate">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Convenience literal for the date from which the normative content is effective.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">effective date</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#jurisdiction">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Jurisdiction or legal scope of the normative content.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">jurisdiction</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#deonticId">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Unique identifier for a norm or constitutive rule within the regulation pack.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">deontic ID</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#normStatement">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Human-readable restatement of the norm or rule.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">norm statement</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#hasLastReviewTime">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links normative content to the instant of its latest review.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">has last review time</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2006/time#Instant"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#hasAnnotationTime">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links normative content to the instant at which the annotation was created.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">has annotation time</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2006/time#Instant"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#hasDeadlineTime">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links normative content to the instant representing its deadline or sunset time.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">has deadline time</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2006/time#Instant"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#hasEffectiveTime">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links normative content to the instant at which it becomes effective.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">has effective time</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2006/time#Instant"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#hasTemporalValidity">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links normative content to the interval during which it is valid or applicable.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">has temporal validity</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#TemporalValidity"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#supersededBy">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a superseded normative content item to the item that replaces it.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">superseded by</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#relatesTo">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Associates one normative content item with another related one.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">relates to</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#triggersNorm">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a legal condition to the normative content it triggers.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">triggers norm</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#LegalCondition"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#hasBindingForce">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Associates a regulative norm with one binding-force value.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">has binding force</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#BindingForce"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#RegulativeNorm"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#hasReviewStatus">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Associates a normative content item with one review status.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">has review status</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#ReviewStatus"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#hasExtractionMethod">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Associates a normative content item with the method used to produce its annotation.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">has extraction method</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#ExtractionMethod"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#hasComplianceCriticality">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Associates a regulative norm with one compliance criticality value.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">has compliance criticality</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#ComplianceCriticality"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#RegulativeNorm"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#hasNormStatus">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Associates a normative content item with one lifecycle status.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">has norm status</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormStatus"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#generatedAtTime">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Timestamp at which the normative content was generated as an annotation artifact.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">generated at time</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<subPropertyOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#generatedAtTime"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#wasDerivedFromSource">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links normative content to the legal source from which it was derived.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">was derived from source</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#LegalSource"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<subPropertyOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#usedLegalSource">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links an annotation activity to the legal source it used.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">used legal source</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#LegalSource"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#AnnotationActivity"/>
		<subPropertyOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#used"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#wasGeneratedByAnnotationActivity">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links normative content to the annotation activity that generated it.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">was generated by annotation activity</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#AnnotationActivity"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<subPropertyOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#wasReviewedBy">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a review activity to the provenance agent responsible for carrying it out.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">was reviewed by</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#Agent"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#ReviewActivity"/>
		<subPropertyOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#wasAssociatedWith"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#wasAttributedToAnnotator">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links normative content to the provenance agent responsible for its annotation.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">was attributed to annotator</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#Agent"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<subPropertyOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#wasAttributedTo"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#hasSourceExpression">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links normative content to a specific legal expression of the source resource, such as a language or version-specific expression.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">has source expression</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#LegalSourceExpression"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
