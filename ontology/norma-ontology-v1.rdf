	<rdf:Description rdf:about="https://w3id.org/norma-ontology#normStatement">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Human-readable restatement of the norm. Source: compliance_normStatement.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">norm statement</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
