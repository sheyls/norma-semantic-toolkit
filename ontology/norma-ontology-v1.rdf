	<rdf:Description rdf:about="https://w3id.org/norma-ontology#ReviewActivity">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">An annotation activity that reviews or validates normative content.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Review Activity</label>
		<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#AnnotationActivity"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#ExtractionActivity">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">An annotation activity that extracts normative content from a legal source.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Extraction Activity</label>
		<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#AnnotationActivity"/>
