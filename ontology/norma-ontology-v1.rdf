		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#AnnotationActivity">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A provenance activity that produces or modifies a normative annotation.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Annotation Activity</label>
		<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#Activity"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#TemporalValidity">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A temporal interval representing the validity or applicability period of normative content.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Temporal Validity</label>
		<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2006/time#Interval"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#LegalObject">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The entity, resource, person, document, system, content, or data item toward which the regulated action is directed.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Legal Object</label>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#LegalAction">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A normalized legal action that is prescribed, prohibited, permitted, or recommended by a regulative norm.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Legal Action</label>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#OrganizationalLegalAgent">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A legal agent that is also an organization in the sense of the W3C Organization Ontology.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Organizational Legal Agent</label>
		<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/org#Organization"/>
		<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#LegalAgent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#LegalAgent">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">An entity that bears the legally relevant role of subject of a regulative norm, that is, the party that is obliged, prohibited, permitted, or recommended to perform a legal action.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Legal Agent</label>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#ConstitutiveRule">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A normative content item that defines, classifies, or constitutes a legal concept, status, or institutional fact.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Constitutive Rule</label>
		<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#RegulativeNorm">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A normative content item that regulates conduct by prescribing, prohibiting, permitting, or recommending a legal action.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Regulative Norm</label>
		<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#LegalSourceExpression">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A concrete legal expression of a legal source, such as a specific language, version, or published expression of the legal resource.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Legal Source Expression</label>
		<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://data.europa.eu/eli/ontology#LegalExpression"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#LegalSource">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A legal resource from which normative content is extracted, cited, or traced.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Legal Source</label>
		<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://data.europa.eu/eli/ontology#LegalResource"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#LegalCondition">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A legally relevant condition, fact pattern, or decision criterion whose satisfaction determines whether normative content becomes applicable or is triggered.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Legal Condition</label>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#NormativeContent">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">An informational entity that expresses machine-readable legal-normative content extracted or formulated from a legal source, including either a regulative norm or a constitutive rule.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Normative Content</label>
		<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#Entity"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Publication-quality ontology aligned to the NORMA annotation model and BPMN legal compliance workflow.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">NORMA ontology</label>
		<preferredNamespaceUri xmlns="http://purl.org/vocab/vann/">https://w3id.org/norma-ontology#</preferredNamespaceUri>
		<preferredNamespacePrefix xmlns="http://purl.org/vocab/vann/">norma</preferredNamespacePrefix>
		<creator xmlns="http://purl.org/dc/terms/" xml:lang="en">Sheyla Leyva-Sánchez et al.</creator>
		<publisher xmlns="http://purl.org/dc/terms/" xml:lang="en">NORMA project</publisher>
		<language xmlns="http://purl.org/dc/terms/" rdf:resource="http://id.loc.gov/vocabulary/iso639-1/en"/>
		<license xmlns="http://purl.org/dc/terms/" rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
		<modified xmlns="http://purl.org/dc/terms/" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-15</modified>
		<created xmlns="http://purl.org/dc/terms/" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-15</created>
		<description xmlns="http://purl.org/dc/terms/" xml:lang="en">Ontology for representing machine-readable legal compliance annotations derived from BPMN element templates in the NORMA pipeline. The ontology models normative content, deontic modalities, legal conditions, legal sources, legal agents, legal actions, legal objects, provenance metadata, and temporal validity for compliance processing.</description>
		<alternative xmlns="http://purl.org/dc/terms/" xml:lang="en">NORMA Ontology</alternative>
		<title xmlns="http://purl.org/dc/terms/" xml:lang="en">NORMA — Normative Ontology for Regulatory Machine-readable Annotations</title>
		<versionInfo xmlns="http://www.w3.org/2002/07/owl#">1.0</versionInfo>
		<versionIRI xmlns="http://www.w3.org/2002/07/owl#" rdf:resource="https://w3id.org/norma-ontology/1.0"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
	</rdf:Description>
</rdf:RDF>