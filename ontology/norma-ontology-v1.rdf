	<rdf:Description rdf:about="https://w3id.org/norma-ontology#NegativeRecommendation">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Template value: recommendation_not — SHOULD NOT.</comment>
		<identifier xmlns="http://purl.org/dc/terms/">REC_NOT</identifier>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Negative Recommendation</label>
		<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#RegulativeNorm"/>
