	<rdf:Description rdf:about="https://w3id.org/norma-ontology#ConstitutiveRule">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A rule that classifies or defines a legal concept. Covers deonticType: fact.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Constitutive Rule</label>
		<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#RegulativeNorm">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A norm that prescribes, prohibits, or permits behaviour. Covers deonticType: obligation, prohibition, permission, recommendation, recommendation_not.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Regulative Norm</label>
		<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
