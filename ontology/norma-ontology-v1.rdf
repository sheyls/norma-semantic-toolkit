	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#object">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Raw string label of the legal object as entered in the template. Used by the pipeline to mint or look up the LegalObject individual. Source: compliance_object.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">object (label)</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
