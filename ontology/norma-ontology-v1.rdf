	<rdf:Description rdf:about="https://w3id.org/norma-ontology#Prohibition">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Template value: prohibition — MUST NOT.</comment>
		<identifier xmlns="http://purl.org/dc/terms/">PRH</identifier>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Prohibition</label>
