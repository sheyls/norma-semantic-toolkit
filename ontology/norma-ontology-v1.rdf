	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#triggersNorm">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a gateway condition to the norms on its outgoing branches. Source: gw_crossRefs.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">triggers norm</label>
