	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#deonticId">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Unique norm identifier within the regulation pack. Pattern: OBL_xxx | PRH_xxx | PER_xxx | REC_xxx | REC_NOT_xxx | FCT_xxx. Source: compliance_deonticId.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">deontic ID</label>
