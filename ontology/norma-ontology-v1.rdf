<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:its="http://www.w3.org/2005/11/its">
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#lastReviewDate">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Source: compliance_lastReviewDate (YYYY-MM-DD).</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">last reviewed date</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#annotationDate">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Source: compliance_annotationDate (YYYY-MM-DD).</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">annotation date</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#annotator">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Name or identifier of the person who created this annotation. Source: compliance_annotator.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">annotator</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#confidenceScore">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Annotator certainty in [0.0, 1.0]. Values below 0.7 trigger mandatory legal review. Source: compliance_confidence.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">confidence score</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#sourceURI">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">SWRL shortcut — denormalised copy of norma:regulationURI for use in rule heads.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">source URI</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#fromParagraph">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">SWRL shortcut — denormalised copy of norma:paragraphNumber for use in rule heads.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">from paragraph</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#fromArticle">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">SWRL shortcut — denormalised copy of norma:articleNumber for use in rule heads.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">from article</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#fromRegulation">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">SWRL shortcut — denormalised copy of norma:regulationName for use in rule heads.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">from regulation</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#regulationURI">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Dereferenceable URI of the source document (ELI-compatible). Source: compliance_regulationURI.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">regulation URI</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#LegalSource"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#originalText">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Verbatim quote from the source legislative text for traceability. Source: compliance_originalText.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">original legal text</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#LegalSource"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#paragraphNumber">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Paragraph or subsection within the article. Source: compliance_paragraph.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">paragraph number</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#LegalSource"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#articleNumber">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Article or section number within the source document. Source: compliance_article.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">article number</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#LegalSource"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#regulationName">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Name of the source regulation (e.g. &apos;EU AI Act&apos;, &apos;GDPR&apos;). Source: compliance_regulation.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">regulation name</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#LegalSource"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#crossRefsNorm">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Comma-separated deontic IDs of related norms. Source: compliance_crossRefs. Parsed by pipeline into norma:relatesTo object property assertions.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">norm cross-references</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#sanction">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Consequence of breaching this norm. Source: compliance_sanction.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">sanction</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#RegulativeNorm"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#exception">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Conditions under which this norm does NOT apply. Free text; formal negation handled by DDL layer. Source: compliance_exception.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">exception / carve-out</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#RegulativeNorm"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#deadline">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Source: compliance_deadline (YYYY-MM-DD).</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">deadline / sunset date</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#effectiveDate">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Source: compliance_effectiveDate (YYYY-MM-DD).</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">effective date</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#jurisdiction">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Geographic or legal scope (e.g. EU, US-CA, UK, global). Source: compliance_jurisdiction.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">jurisdiction</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#NormativeContent"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#conditionTrigger">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Free-text description of when this norm applies. Human-readable only; not parsed into SWRL bodies. Restricted to regulative norms — constitutive facts do not have trigger conditions. Source: compliance_triggerCondition.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">trigger condition</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#RegulativeNorm"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#crossRefsGateway">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Comma-separated deontic IDs triggered by this condition. Source: gw_crossRefs. Parsed by pipeline into norma:triggersNorm object property assertions.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">gateway cross-references</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#LegalCondition"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#falseBranchLabel">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Display label when condition is not met (e.g. &apos;No&apos;). Source: gw_falseBranch.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">false branch label</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#LegalCondition"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#trueBranchLabel">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Display label when condition is met (e.g. &apos;Yes&apos;). Source: gw_trueBranch.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">true branch label</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#LegalCondition"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#conditionStatement">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Plain-language question evaluated at this gateway. Source: gw_conditionStatement.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">condition statement</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#LegalCondition"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://w3id.org/norma-ontology#factStatement">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The constitutive classification or legal definition in plain text. Source: compliance_factStatement.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">fact statement</label>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology#ConstitutiveRule"/>
		<isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/norma-ontology"/>
