<?xml version="1.0"?>
<rdf:RDF
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:swrl="http://www.w3.org/2003/11/swrl#"
  xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
  xml:base="https://w3id.org/norma-abox/eu-ai-act/rules">

  <owl:Ontology rdf:about="https://w3id.org/norma-abox/eu-ai-act/rules">
    <owl:imports rdf:resource="https://w3id.org/norma-abox/eu-ai-act"/>
  </owl:Ontology>

  <!-- Rules-local datatype properties used in SWRL bodies -->
  <owl:DatatypeProperty rdf:about="https://w3id.org/norma-abox/eu-ai-act/rules#Generation_of_syntetic_content"/>

  <!-- SWRL Variables -->
  <swrl:Variable rdf:about="https://w3id.org/norma-abox/eu-ai-act/rules#var_x"/>

  <!-- SWRL Rules -->
  <swrl:Imp rdf:about="https://w3id.org/norma-abox/eu-ai-act/rules#r1">
    <swrl:body>
        <swrl:AtomList>
          <rdf:first>
            <swrl:DatavaluedPropertyAtom>
              <swrl:propertyPredicate rdf:resource="https://w3id.org/norma-abox/eu-ai-act/rules#Generation_of_syntetic_content"/>
              <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act/rules#var_x"/>
              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2>
            </swrl:DatavaluedPropertyAtom>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </swrl:AtomList>
    </swrl:body>
    <swrl:head>
        <swrl:AtomList>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="https://w3id.org/norma-ontology#performsAction"/>
              <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#Agent_AI_owner"/>
              <swrl:argument2 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#OBL_1"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <swrl:AtomList>
              <rdf:first>
                <swrl:IndividualPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="https://w3id.org/norma-ontology#actsOn"/>
                  <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#OBL_1"/>
                  <swrl:argument2 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#Object_generate_content"/>
                </swrl:IndividualPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <swrl:AtomList>
                  <rdf:first>
                    <swrl:IndividualPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="https://w3id.org/norma-ontology#hasBindingForce"/>
                      <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#OBL_1"/>
                      <swrl:argument2 rdf:resource="https://w3id.org/norma-ontology#HardLaw"/>
                    </swrl:IndividualPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <swrl:AtomList>
                      <rdf:first>
                        <swrl:IndividualPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="https://w3id.org/norma-ontology#hasRiskLevel"/>
                          <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#OBL_1"/>
                          <swrl:argument2 rdf:resource="https://w3id.org/norma-ontology#HighRisk"/>
                        </swrl:IndividualPropertyAtom>
                      </rdf:first>
                      <rdf:rest>
                        <swrl:AtomList>
                          <rdf:first>
                            <swrl:DatavaluedPropertyAtom>
                              <swrl:propertyPredicate rdf:resource="https://w3id.org/norma-ontology#deonticId"/>
                              <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#OBL_1"/>
                              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OBL_1</swrl:argument2>
                            </swrl:DatavaluedPropertyAtom>
                          </rdf:first>
                          <rdf:rest>
                            <swrl:AtomList>
                              <rdf:first>
                                <swrl:DatavaluedPropertyAtom>
                                  <swrl:propertyPredicate rdf:resource="https://w3id.org/norma-ontology#fromRegulation"/>
                                  <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#OBL_1"/>
                                  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EU AI Act</swrl:argument2>
                                </swrl:DatavaluedPropertyAtom>
                              </rdf:first>
                              <rdf:rest>
                                <swrl:AtomList>
                                  <rdf:first>
                                    <swrl:DatavaluedPropertyAtom>
                                      <swrl:propertyPredicate rdf:resource="https://w3id.org/norma-ontology#fromArticle"/>
                                      <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#OBL_1"/>
                                      <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4</swrl:argument2>
                                    </swrl:DatavaluedPropertyAtom>
                                  </rdf:first>
                                  <rdf:rest>
                                    <swrl:AtomList>
                                      <rdf:first>
                                        <swrl:DatavaluedPropertyAtom>
                                          <swrl:propertyPredicate rdf:resource="https://w3id.org/norma-ontology#fromParagraph"/>
                                          <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#OBL_1"/>
                                          <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2</swrl:argument2>
                                        </swrl:DatavaluedPropertyAtom>
                                      </rdf:first>
                                      <rdf:rest>
                                        <swrl:AtomList>
                                          <rdf:first>
                                            <swrl:DatavaluedPropertyAtom>
                                              <swrl:propertyPredicate rdf:resource="https://w3id.org/norma-ontology#sourceURI"/>
                                              <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#OBL_1"/>
                                              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">hhtps://</swrl:argument2>
                                            </swrl:DatavaluedPropertyAtom>
                                          </rdf:first>
                                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                        </swrl:AtomList>
                                      </rdf:rest>
                                    </swrl:AtomList>
                                  </rdf:rest>
                                </swrl:AtomList>
                              </rdf:rest>
                            </swrl:AtomList>
                          </rdf:rest>
                        </swrl:AtomList>
                      </rdf:rest>
                    </swrl:AtomList>
                  </rdf:rest>
                </swrl:AtomList>
              </rdf:rest>
            </swrl:AtomList>
          </rdf:rest>
        </swrl:AtomList>
    </swrl:head>
  </swrl:Imp>

  <swrl:Imp rdf:about="https://w3id.org/norma-abox/eu-ai-act/rules#r2">
    <swrl:body>
        <swrl:AtomList>
          <rdf:first>
            <swrl:DatavaluedPropertyAtom>
              <swrl:propertyPredicate rdf:resource="https://w3id.org/norma-abox/eu-ai-act/rules#Generation_of_syntetic_content"/>
              <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act/rules#var_x"/>
              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</swrl:argument2>
            </swrl:DatavaluedPropertyAtom>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </swrl:AtomList>
    </swrl:body>
    <swrl:head>
        <swrl:AtomList>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="https://w3id.org/norma-ontology#performsAction"/>
              <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#Agent_AI_owner"/>
              <swrl:argument2 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#REC_1"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <swrl:AtomList>
              <rdf:first>
                <swrl:IndividualPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="https://w3id.org/norma-ontology#actsOn"/>
                  <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#REC_1"/>
                  <swrl:argument2 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#Object_generate_content"/>
                </swrl:IndividualPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <swrl:AtomList>
                  <rdf:first>
                    <swrl:IndividualPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="https://w3id.org/norma-ontology#hasBindingForce"/>
                      <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#REC_1"/>
                      <swrl:argument2 rdf:resource="https://w3id.org/norma-ontology#SoftLaw"/>
                    </swrl:IndividualPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <swrl:AtomList>
                      <rdf:first>
                        <swrl:IndividualPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="https://w3id.org/norma-ontology#hasRiskLevel"/>
                          <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#REC_1"/>
                          <swrl:argument2 rdf:resource="https://w3id.org/norma-ontology#LowRisk"/>
                        </swrl:IndividualPropertyAtom>
                      </rdf:first>
                      <rdf:rest>
                        <swrl:AtomList>
                          <rdf:first>
                            <swrl:DatavaluedPropertyAtom>
                              <swrl:propertyPredicate rdf:resource="https://w3id.org/norma-ontology#deonticId"/>
                              <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#REC_1"/>
                              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">REC_1</swrl:argument2>
                            </swrl:DatavaluedPropertyAtom>
                          </rdf:first>
                          <rdf:rest>
                            <swrl:AtomList>
                              <rdf:first>
                                <swrl:DatavaluedPropertyAtom>
                                  <swrl:propertyPredicate rdf:resource="https://w3id.org/norma-ontology#fromRegulation"/>
                                  <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#REC_1"/>
                                  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EU AI Act</swrl:argument2>
                                </swrl:DatavaluedPropertyAtom>
                              </rdf:first>
                              <rdf:rest>
                                <swrl:AtomList>
                                  <rdf:first>
                                    <swrl:DatavaluedPropertyAtom>
                                      <swrl:propertyPredicate rdf:resource="https://w3id.org/norma-ontology#fromArticle"/>
                                      <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#REC_1"/>
                                      <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5</swrl:argument2>
                                    </swrl:DatavaluedPropertyAtom>
                                  </rdf:first>
                                  <rdf:rest>
                                    <swrl:AtomList>
                                      <rdf:first>
                                        <swrl:DatavaluedPropertyAtom>
                                          <swrl:propertyPredicate rdf:resource="https://w3id.org/norma-ontology#fromParagraph"/>
                                          <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#REC_1"/>
                                          <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2</swrl:argument2>
                                        </swrl:DatavaluedPropertyAtom>
                                      </rdf:first>
                                      <rdf:rest>
                                        <swrl:AtomList>
                                          <rdf:first>
                                            <swrl:DatavaluedPropertyAtom>
                                              <swrl:propertyPredicate rdf:resource="https://w3id.org/norma-ontology#sourceURI"/>
                                              <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#REC_1"/>
                                              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">hhtps://...</swrl:argument2>
                                            </swrl:DatavaluedPropertyAtom>
                                          </rdf:first>
                                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                        </swrl:AtomList>
                                      </rdf:rest>
                                    </swrl:AtomList>
                                  </rdf:rest>
                                </swrl:AtomList>
                              </rdf:rest>
                            </swrl:AtomList>
                          </rdf:rest>
                        </swrl:AtomList>
                      </rdf:rest>
                    </swrl:AtomList>
                  </rdf:rest>
                </swrl:AtomList>
              </rdf:rest>
            </swrl:AtomList>
          </rdf:rest>
        </swrl:AtomList>
    </swrl:head>
  </swrl:Imp>

</rdf:RDF>
