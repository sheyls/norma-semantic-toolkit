  <!-- SWRL Rules -->
  <swrl:Imp rdf:about="https://w3id.org/norma-abox/eu-ai-act/rules#r2">
    <swrl:body>
        <swrl:AtomList>
          <rdf:first>
            <swrl:DatavaluedPropertyAtom>
              <swrl:propertyPredicate rdf:resource="https://w3id.org/norma-abox/eu-ai-act/rules#Has_it_been_certified_under_the_EU_cybersecurity_scheme"/>
              <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act/rules#var_x"/>
              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2>
            </swrl:DatavaluedPropertyAtom>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </swrl:AtomList>
    </swrl:body>
    <swrl:head>
        <swrl:AtomList>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="https://w3id.org/def/norma-o#activatesNorm"/>
              <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#TriggerEvent_Condition_Has_it_been_certified_under_the_EU_cybersecurity_scheme_True_REC_NOT_Respect_cybersecurity_exemption"/>
              <swrl:argument2 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#REC_NOT_Respect_cybersecurity_exemption"/>
            </swrl:IndividualPropertyAtom>
