            </swrl:AtomList>
          </rdf:rest>
        </swrl:AtomList>
    </swrl:body>
    <swrl:head>
        <swrl:AtomList>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="https://w3id.org/def/norma-o#activatesNorm"/>
              <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#TriggerEvent_Condition_Does_it_work_on_a_large_amount_of_data_True_OBL_Respect_general_purpose_obligations"/>
