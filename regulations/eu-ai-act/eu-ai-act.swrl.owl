<?xml version="1.0"?>
<rdf:RDF
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:swrl="http://www.w3.org/2003/11/swrl#"
  xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
  xml:base="https://w3id.org/norma-abox/eu-ai-act/rules">

  <owl:Ontology rdf:about="https://w3id.org/norma-abox/eu-ai-act/rules">
    <owl:imports rdf:resource="https://w3id.org/norma-abox/eu-ai-act"/>
  </owl:Ontology>

  <!-- Rules-local datatype properties used in SWRL bodies -->
  <owl:DatatypeProperty rdf:about="https://w3id.org/norma-abox/eu-ai-act/rules#Is_the_AI_system_tested_in_reallife_before_entering_into_the_market"/>
  <owl:DatatypeProperty rdf:about="https://w3id.org/norma-abox/eu-ai-act/rules#Is_the_AI_system_used_for_biometric_purposes"/>

  <!-- SWRL Variables -->
  <swrl:Variable rdf:about="https://w3id.org/norma-abox/eu-ai-act/rules#var_x"/>

  <!-- SWRL Rules -->
  <swrl:Imp rdf:about="https://w3id.org/norma-abox/eu-ai-act/rules#r2">
    <swrl:body>
        <swrl:AtomList>
          <rdf:first>
            <swrl:DatavaluedPropertyAtom>
              <swrl:propertyPredicate rdf:resource="https://w3id.org/norma-abox/eu-ai-act/rules#Is_the_AI_system_used_for_biometric_purposes"/>
              <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act/rules#var_x"/>
              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2>
            </swrl:DatavaluedPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <swrl:AtomList>
              <rdf:first>
                <swrl:DatavaluedPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="https://w3id.org/norma-abox/eu-ai-act/rules#Is_the_AI_system_tested_in_reallife_before_entering_into_the_market"/>
                  <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act/rules#var_x"/>
                  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</swrl:argument2>
                </swrl:DatavaluedPropertyAtom>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </swrl:AtomList>
          </rdf:rest>
        </swrl:AtomList>
    </swrl:body>
    <swrl:head>
        <swrl:AtomList>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="https://w3id.org/def/norma-o#activatesNorm"/>
              <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#TriggerEvent_Condition_Is_the_AI_system_tested_in_real_life_before_entering_into_the_market_False_OBL_Respect_high_risk_obligations"/>
              <swrl:argument2 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#OBL_Respect_high_risk_obligations"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </swrl:AtomList>
    </swrl:head>
  </swrl:Imp>

  <swrl:Imp rdf:about="https://w3id.org/norma-abox/eu-ai-act/rules#r3">
    <swrl:body>
        <swrl:AtomList>
          <rdf:first>
            <swrl:DatavaluedPropertyAtom>
              <swrl:propertyPredicate rdf:resource="https://w3id.org/norma-abox/eu-ai-act/rules#Is_the_AI_system_used_for_biometric_purposes"/>
              <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act/rules#var_x"/>
              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2>
            </swrl:DatavaluedPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <swrl:AtomList>
              <rdf:first>
                <swrl:DatavaluedPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="https://w3id.org/norma-abox/eu-ai-act/rules#Is_the_AI_system_tested_in_reallife_before_entering_into_the_market"/>
                  <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act/rules#var_x"/>
                  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2>
                </swrl:DatavaluedPropertyAtom>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </swrl:AtomList>
          </rdf:rest>
        </swrl:AtomList>
    </swrl:body>
    <swrl:head>
        <swrl:AtomList>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="https://w3id.org/def/norma-o#activatesNorm"/>
              <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#TriggerEvent_Condition_Is_the_AI_system_tested_in_real_life_before_entering_into_the_market_True_OBL_Respect_high_risk_obligations"/>
              <swrl:argument2 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#OBL_Respect_high_risk_obligations"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <swrl:AtomList>
              <rdf:first>
                <swrl:IndividualPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="https://w3id.org/def/norma-o#activatesNorm"/>
                  <swrl:argument1 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#TriggerEvent_Condition_Is_the_AI_system_tested_in_real_life_before_entering_into_the_market_True_OBL_ADD_testing_obligations"/>
                  <swrl:argument2 rdf:resource="https://w3id.org/norma-abox/eu-ai-act#OBL_ADD_testing_obligations"/>
                </swrl:IndividualPropertyAtom>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </swrl:AtomList>
          </rdf:rest>
        </swrl:AtomList>
    </swrl:head>
  </swrl:Imp>

</rdf:RDF>
