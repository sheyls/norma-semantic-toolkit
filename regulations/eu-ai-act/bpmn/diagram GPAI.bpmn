          <zeebe:property name="compliance_riskLevel" value="high" />
          <zeebe:property name="compliance_regulation" value="AI Act" />
          <zeebe:property name="compliance_article" value="42" />
          <zeebe:property name="compliance_paragraph" value="2" />
          <zeebe:property name="compliance_originalText" value="High-risk AI systems that have been certified or for which a statement of conformity has been issued under a cybersecurity scheme pursuant to Regulation (EU) 2019/881 and the references of which have been published in the Official Journal of the European Union shall be presumed to comply with the cybersecurity requirements set out in Article 15 of this Regulation in so far as the cybersecurity certificate or statement of conformity or parts thereof cover those requirements" />
          <zeebe:property name="compliance_regulationURI" value="" />
          <zeebe:property name="compliance_extractionMethod" value="manual_lawyer" />
          <zeebe:property name="compliance_confidence" value="1.0" />
