    <bpmn:task id="Activity_136kc4k" name="Cybersecurity Exemption" zeebe:modelerTemplate="norma.compliance.annotation.v1" zeebe:modelerTemplateVersion="1">
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="compliance_elementType" value="task" />
          <zeebe:property name="compliance_deonticType" value="recommendation_not" />
          <zeebe:property name="compliance_normStatement" value="AI systems that have been certified under a cybersecurity scheme shall be presumed to comply with the cybersecurity requirements" />
          <zeebe:property name="compliance_agent" value="AI provider" />
          <zeebe:property name="compliance_action" value="be exempted from cybersecurity requirements" />
          <zeebe:property name="compliance_object" value="AI system" />
          <zeebe:property name="compliance_bindingForce" value="hard_law" />
          <zeebe:property name="compliance_triggerCondition" value="" />
