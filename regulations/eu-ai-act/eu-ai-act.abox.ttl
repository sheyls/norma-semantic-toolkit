    a owl:NamedIndividual, norma:LegalCondition ;
    rdfs:label "Is the AI system tested in real-life before entering into the market?"@en ;
    norma:conditionStatement "Is the AI system tested in real-life before entering into the market?"^^xsd:string ;
    norma:hasTrigger :TriggerEvent_Condition_Is_the_AI_system_tested_in_real_life_before_entering_into_the_market_False_OBL_Respect_high_risk_obligations ;
    norma:hasTrigger :TriggerEvent_Condition_Is_the_AI_system_tested_in_real_life_before_entering_into_the_market_True_OBL_ADD_testing_obligations ;
    norma:hasTrigger :TriggerEvent_Condition_Is_the_AI_system_tested_in_real_life_before_entering_into_the_market_True_OBL_Respect_high_risk_obligations.

:TriggerEvent_Condition_Is_the_AI_system_tested_in_real_life_before_entering_into_the_market_False_OBL_Respect_high_risk_obligations
    a owl:NamedIndividual, norma:TriggerEvent ;
    norma:hasOutcome norma:FalseOutcome .

