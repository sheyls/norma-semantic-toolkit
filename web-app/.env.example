# ── Local development only ─────────────────────────────────────────────────────
# The Vite dev server proxies /api/* to the FastAPI backend.
# In production, FastAPI serves the built frontend directly (same origin) so
# this variable is not used.
VITE_PROXY_TARGET=http://localhost:8000

# Set to override the API base URL when calling from a different origin.
# Leave empty when frontend and backend share the same origin (the default).
VITE_API_BASE=

# ── Backend paths ──────────────────────────────────────────────────────────────
# Directory where SQLite DB, graph stores, and uploaded BPMN files are written.
# Defaults to ./backend/data relative to the web-app folder.
NORMA_DATA_DIR=./backend/data

# Absolute path to the norma_engine package root if it is not auto-detected
# from the monorepo layout. Leave empty when running from the repository root.
NORMA_CORE_ROOT=

# Paths to core repository assets. In this monorepo these resolve automatically.
# Override only if you relocate these directories on the deployment server.
NORMA_REGULATIONS_DIR=
NORMA_ONTOLOGY_PATH=
NORMA_CAMUNDA_TEMPLATE_PATH=

# ── Security ───────────────────────────────────────────────────────────────────
# CORS allowed origins. Only needed when the frontend is served from a
# DIFFERENT origin than the API (e.g. a CDN). Leave empty when both are on the
# same domain (the recommended same-origin deployment).
NORMA_ALLOWED_ORIGINS=

# Maximum BPMN upload size in bytes (default: 10 MB).
NORMA_MAX_UPLOAD_BYTES=10485760

# Maximum SPARQL query size in bytes (default: 64 KB).
NORMA_MAX_SPARQL_BYTES=65536
