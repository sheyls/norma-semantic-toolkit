# Frontend
VITE_PROXY_TARGET=http://localhost:8000
VITE_API_BASE=

# Backend runtime data
NORMA_DATA_DIR=./backend/data

# Preferred: install `norma_engine` as a package in the web-app environment.
# In this monorepo, the default root is used automatically.
# Set this only if the core engine package lives somewhere else.
NORMA_CORE_ROOT=

# Core repository assets. In this monorepo they resolve automatically from
# the repository root. Override them only if you intentionally relocate them.
NORMA_REGULATIONS_DIR=
NORMA_ONTOLOGY_PATH=
NORMA_CAMUNDA_TEMPLATE_PATH=
