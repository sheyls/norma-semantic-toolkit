# Same-origin production deployment behind a reverse proxy.
# The browser should load both the SPA and the API from
# https://norma-toolkit.linkeddata.es, proxied to http://127.0.0.1:8000

NORMA_DATA_DIR=/data
NORMA_ALLOWED_ORIGINS=https://norma-toolkit.linkeddata.es
NORMA_MAX_UPLOAD_BYTES=10485760
NORMA_MAX_SPARQL_BYTES=65536

# Usually not needed in the container image because the monorepo layout is preserved.
NORMA_CORE_ROOT=
NORMA_REGULATIONS_DIR=
NORMA_ONTOLOGY_PATH=
NORMA_CAMUNDA_TEMPLATE_PATH=
