<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/norma-o#"
     xml:base="https://w3id.org/norma-o"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns="http://www.w3.org/2003/06/sw-vocab-status/ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:wot="http://xmlns.com/wot/0.1/"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:bibo="http://purl.org/ontology/bibo/"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:ontology="http://data.europa.eu/eli/ontology#">
    <owl:Ontology rdf:about="https://w3id.org/norma-o">
        <owl:versionIRI rdf:resource="https://w3id.org/norma-o/1.0"/>
        <owl:imports rdf:resource="http://data.europa.eu/eli/ontology"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/prov-o"/>
        <owl:imports rdf:resource="http://xmlns.com/foaf/0.1/"/>
        <terms:alternative xml:lang="en">NORMA Ontology</terms:alternative>
        <terms:bibliographicCitation xml:lang="en">Leyva-Sánchez, S. et al. (2026). NORMA-O: The NORMA Ontology for Legal Norm Annotations (Version 1.0) [Ontology]. https://w3id.org/norma-o/1.0</terms:bibliographicCitation>
        <terms:contributor rdf:nodeID="genid1"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-15</terms:created>
        <terms:creator rdf:nodeID="genid2"/>
        <terms:description xml:lang="en">Ontology for representing machine-readable legal norm annotations derived from BPMN workflow models in the NORMA pipeline. The ontology models regulative norms (obligations, prohibitions, permissions, and recommendations) and constitutive rules expressing legal responsibilities, along with legal conditions, legal sources, legal agents, legal objects, provenance metadata and lifecycle status. It aligns with PROV-O (provenance), ELI (legal resources), and FOAF (agents and project metadata). Legal conditions are connected to normative content via a W3C n-ary relation pattern (TriggerEvent) that associates each condition outcome with the specific normative content it activates.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-17</terms:issued>
        <terms:language rdf:resource="http://id.loc.gov/vocabulary/iso639-1/en"/>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by-nc/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-25</terms:modified>
        <terms:publisher rdf:nodeID="genid3"/>
        <terms:source rdf:resource="https://github.com/sheyls/norma-semantic-toolkit"/>
        <terms:title xml:lang="en">NORMA-O: The NORMA Ontology for Legal Norm Annotations</terms:title>
        <bibo:doi>10.5281/zenodo.19765302</bibo:doi>
        <bibo:status xml:lang="en">Published</bibo:status>
        <vann:preferredNamespacePrefix>norma</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/norma-o#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">Publication-quality ontology aligned to the NORMA annotation model and BPMN legal compliance workflow.</rdfs:comment>
        <rdfs:label xml:lang="en">NORMA ontology</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/swbp-n-aryRelations/"/>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>
    <rdf:Description rdf:nodeID="genid1">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <foaf:name>NORMA project contributors</foaf:name>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid2">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <foaf:name>Sheyla Leyva-Sánchez</foaf:name>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid3">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
        <foaf:name>NORMA project</foaf:name>
    </rdf:Description>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/alternative -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/alternative"/>
    


    <!-- http://purl.org/dc/terms/bibliographicCitation -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/bibliographicCitation"/>
    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/language -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/language"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/publisher -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/dc/terms/source -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>
    


    <!-- http://purl.org/ontology/bibo/doi -->


    <owl:AnnotationProperty rdf:about="http://purl.org/ontology/bibo/doi"/>
    


    <!-- http://purl.org/ontology/bibo/status -->


    <owl:AnnotationProperty rdf:about="http://purl.org/ontology/bibo/status"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/1999/02/22-rdf-syntax-ns#value -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#value"/>
    


    <!-- https://w3id.org/norma-o#activatesNorm -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#activatesNorm">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#value"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#TriggerEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:comment xml:lang="en">Links a trigger event to the normative content it activates. Declared functional because each trigger event activates exactly one normative content item. Declared as a subproperty of rdf:value to mark the activated norm as the main value of the reified n-ary relation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">activates norm</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#generatedNormativeContent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#generatedNormativeContent">
        <owl:inverseOf rdf:resource="https://w3id.org/norma-o#wasGeneratedByAnnotationActivity"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#AnnotationActivity"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:comment xml:lang="en">Links an annotation activity to normative content that it generated.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">generated normative content</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#hasBindingForce -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#hasBindingForce">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#RegulativeNorm"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#BindingForce"/>
        <rdfs:comment xml:lang="en">Associates a regulative norm with exactly one binding-force value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">has binding force</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#hasComplianceCriticality -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#hasComplianceCriticality">
        <owl:inverseOf rdf:resource="https://w3id.org/norma-o#isComplianceCriticalityOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#RegulativeNorm"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#ComplianceCriticality"/>
        <rdfs:comment xml:lang="en">Associates a regulative norm with exactly one compliance-criticality value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">has compliance criticality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#hasExtractionMethod -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#hasExtractionMethod">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#ExtractionMethod"/>
        <rdfs:comment xml:lang="en">Associates a normative content item with the method used to produce its annotation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">has extraction method</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#hasLegalAction -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#hasLegalAction">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#RegulativeNorm"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#LegalAction"/>
        <rdfs:comment xml:lang="en">Links a regulative norm to the legal action it regulates. The NORMA pipeline may instead use the literal shortcut `norma:actionText`; both forms are permitted.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">has legal action</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#hasLegalAgent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#hasLegalAgent">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#RegulativeNorm"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#LegalAgent"/>
        <rdfs:comment xml:lang="en">Links a regulative norm to its norm-bearing legal agent (the subject obliged, prohibited, permitted, or recommended).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">has legal agent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#hasLegalObject -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#hasLegalObject">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#RegulativeNorm"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#LegalObject"/>
        <rdfs:comment xml:lang="en">Links a regulative norm to the legal object of the action it regulates.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">has legal object</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#hasLegalSource -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#hasLegalSource">
        <owl:inverseOf rdf:resource="https://w3id.org/norma-o#isLegalSourceOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#LegalSource"/>
        <rdfs:comment xml:lang="en">Links normative content to the legal source (work-level resource) from which it is extracted.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">has legal source</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#hasNormStatus -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#hasNormStatus">
        <owl:inverseOf rdf:resource="https://w3id.org/norma-o#isNormStatusOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#NormStatus"/>
        <rdfs:comment xml:lang="en">Associates a normative content item with exactly one lifecycle status.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">has norm status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#hasOutcome -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#hasOutcome">
        <owl:inverseOf rdf:resource="https://w3id.org/norma-o#isOutcomeOfTriggerEvent"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#TriggerEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#ConditionOutcome"/>
        <rdfs:comment xml:lang="en">Links a trigger event to the condition outcome that characterises it, for example the true branch, false branch, or another controlled outcome. Declared functional because each trigger event has exactly one outcome.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">has outcome</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#hasReviewStatus -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#hasReviewStatus">
        <owl:inverseOf rdf:resource="https://w3id.org/norma-o#isReviewStatusOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#ReviewStatus"/>
        <rdfs:comment xml:lang="en">Associates a normative content item with one review status.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">has review status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#hasSourceExpression -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#hasSourceExpression">
        <rdfs:subPropertyOf rdf:resource="http://data.europa.eu/eli/ontology#is_realized_by"/>
        <owl:inverseOf rdf:resource="https://w3id.org/norma-o#isSourceExpressionOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#LegalSource"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#LegalSourceExpression"/>
        <rdfs:comment xml:lang="en">Links a LegalSource (ELI work-level) to a specific LegalSourceExpression (language, version, consolidation). Subproperty of `eli:is_realized_by` to preserve ELI semantics.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">has source expression</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#hasTrigger -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#hasTrigger">
        <owl:inverseOf rdf:resource="https://w3id.org/norma-o#isTriggerOfCondition"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#LegalCondition"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#TriggerEvent"/>
        <rdfs:comment xml:lang="en">Links a legal condition to one of its trigger events. A condition may have several trigger events, for example one trigger event for the true branch and one trigger event for the false branch.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">has trigger</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#isActivatedByTriggerEvent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#isActivatedByTriggerEvent">
        <owl:inverseOf rdf:resource="https://w3id.org/norma-o#activatesNorm"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#TriggerEvent"/>
        <rdfs:comment xml:lang="en">Links normative content to a trigger event that activates it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">is activated by trigger event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#isAnnotatorOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#isAnnotatorOf">
        <owl:inverseOf rdf:resource="https://w3id.org/norma-o#wasAttributedToAnnotator"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#AnnotatorAgent"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:comment xml:lang="en">Links an annotator agent to normative content attributed to that annotator.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">is annotator of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#isBindingForceOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#isBindingForceOf">
        <owl:inverseOf rdf:resource="https://w3id.org/norma-o#hasBindingForce"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#BindingForce"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#RegulativeNorm"/>
        <rdfs:comment xml:lang="en">Links a binding-force value to regulative norms classified with that value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">is binding force of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#isComplianceCriticalityOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#isComplianceCriticalityOf">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#ComplianceCriticality"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#RegulativeNorm"/>
        <rdfs:comment xml:lang="en">Links a compliance-criticality value to regulative norms classified with that value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">is compliance criticality of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#isExtractionMethodOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#isExtractionMethodOf">
        <owl:inverseOf rdf:resource="https://w3id.org/norma-o#hasExtractionMethod"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#ExtractionMethod"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:comment xml:lang="en">Links an extraction method to normative content produced using that method.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">is extraction method of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#isLegalActionOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#isLegalActionOf">
        <owl:inverseOf rdf:resource="https://w3id.org/norma-o#hasLegalAction"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#LegalAction"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#RegulativeNorm"/>
        <rdfs:comment xml:lang="en">Links a legal action to the regulative norm that regulates it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">is legal action of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#isLegalAgentOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#isLegalAgentOf">
        <owl:inverseOf rdf:resource="https://w3id.org/norma-o#hasLegalAgent"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#LegalAgent"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#RegulativeNorm"/>
        <rdfs:comment xml:lang="en">Links a legal agent to the regulative norm for which it is the norm-bearing subject.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">is legal agent of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#isLegalObjectOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#isLegalObjectOf">
        <owl:inverseOf rdf:resource="https://w3id.org/norma-o#hasLegalObject"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#LegalObject"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#RegulativeNorm"/>
        <rdfs:comment xml:lang="en">Links a legal object to the regulative norm in which it is regulated.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">is legal object of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#isLegalSourceOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#isLegalSourceOf">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#LegalSource"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:comment xml:lang="en">Links a legal source to normative content extracted or derived from it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">is legal source of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#isNormStatusOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#isNormStatusOf">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#NormStatus"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:comment xml:lang="en">Links a norm-status value to normative content carrying that lifecycle status.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">is norm status of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#isOutcomeOfTriggerEvent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#isOutcomeOfTriggerEvent">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#ConditionOutcome"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#TriggerEvent"/>
        <rdfs:comment xml:lang="en">Links a condition outcome to trigger events characterised by that outcome.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">is outcome of trigger event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#isReviewStatusOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#isReviewStatusOf">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#ReviewStatus"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:comment xml:lang="en">Links a review-status value to normative content carrying that status.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">is review status of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#isSourceExpressionOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#isSourceExpressionOf">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#LegalSourceExpression"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#LegalSource"/>
        <rdfs:comment xml:lang="en">Links a legal source expression to the legal source it realizes or expresses.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">is source expression of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#isSourceForDerivedNormativeContent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#isSourceForDerivedNormativeContent">
        <owl:inverseOf rdf:resource="https://w3id.org/norma-o#wasDerivedFromSource"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#LegalSource"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:comment xml:lang="en">Links a legal source to normative content derived from it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">is source for derived normative content</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#isTriggerOfCondition -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#isTriggerOfCondition">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#TriggerEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#LegalCondition"/>
        <rdfs:comment xml:lang="en">Links a trigger event back to the legal condition whose branch or outcome it represents.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">is trigger of condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#isTriggeredByCondition -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#isTriggeredByCondition">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#LegalCondition"/>
        <rdfs:comment xml:lang="en">Links normative content to the legal condition that triggers it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">is triggered by condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#relatesTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#relatesTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:comment xml:lang="en">Generic symmetric association between two normative content items (e.g. cross-references, thematic links). Prefer more specific properties when available.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">relates to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#supersededBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#supersededBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:comment xml:lang="en">Links a superseded normative content item to the single item that replaces it. Pairs with the `norma:Superseded` NormStatus value. (Note: declared FunctionalProperty; relax this if your domain allows a norm to be split across multiple successors.)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">superseded by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#supersedes -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#supersedes">
        <owl:inverseOf rdf:resource="https://w3id.org/norma-o#supersededBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:comment xml:lang="en">Links normative content to an earlier normative content item that it replaces.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">supersedes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#triggersNorm -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#triggersNorm">
        <owl:inverseOf rdf:resource="https://w3id.org/norma-o#isTriggeredByCondition"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#LegalCondition"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/norma-o#hasTrigger"/>
            <rdf:Description rdf:about="https://w3id.org/norma-o#activatesNorm"/>
        </owl:propertyChainAxiom>
        <rdfs:comment xml:lang="en">Shortcut: links a legal condition to a normative content item whenever the condition has a trigger event that activates that norm. Implemented as the OWL 2 property chain hasTrigger ∘ activatesNorm. The outcome branch is not recoverable from this shortcut alone; clients that need the true, false, or other branch outcome must traverse the reified TriggerEvent node.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">triggers norm</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#usedLegalSource -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#usedLegalSource">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#used"/>
        <owl:inverseOf rdf:resource="https://w3id.org/norma-o#wasUsedByAnnotationActivity"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#AnnotationActivity"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#LegalSource"/>
        <rdfs:comment xml:lang="en">Links an annotation activity to the legal source it used as input.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">used legal source</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#wasAnnotatorAssociatedWithActivity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#wasAnnotatorAssociatedWithActivity">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#AnnotatorAgent"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#AnnotationActivity"/>
        <rdfs:comment xml:lang="en">Links an annotator agent to an annotation activity with which the agent was associated.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">was annotator associated with activity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#wasAssociatedWithAnnotator -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#wasAssociatedWithAnnotator">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasAssociatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/norma-o#wasAnnotatorAssociatedWithActivity"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#AnnotationActivity"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#AnnotatorAgent"/>
        <rdfs:comment xml:lang="en">Links an annotation activity to the annotator agent that performed it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">was associated with annotator</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#wasAttributedToAnnotator -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#wasAttributedToAnnotator">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasAttributedTo"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#AnnotatorAgent"/>
        <rdfs:comment xml:lang="en">Links normative content to the annotator agent responsible for it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">was attributed to annotator</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#wasDerivedFromSource -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#wasDerivedFromSource">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#LegalSource"/>
        <rdfs:comment xml:lang="en">Links normative content to the legal source from which it was derived (entity-to-entity derivation shortcut).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">was derived from source</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#wasGeneratedByAnnotationActivity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#wasGeneratedByAnnotationActivity">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#AnnotationActivity"/>
        <rdfs:comment xml:lang="en">Links normative content to the annotation activity that generated it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">was generated by annotation activity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/norma-o#wasUsedByAnnotationActivity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/norma-o#wasUsedByAnnotationActivity">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#LegalSource"/>
        <rdfs:range rdf:resource="https://w3id.org/norma-o#AnnotationActivity"/>
        <rdfs:comment xml:lang="en">Links a legal source to the annotation activity that used it as input.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">was used by annotation activity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/norma-o#actionText -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/norma-o#actionText">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#RegulativeNorm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Raw textual form of the regulated action as entered in the annotation template.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">action text</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/norma-o#agentText -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/norma-o#agentText">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#RegulativeNorm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Raw textual form of the legal agent as entered in the annotation template.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">agent text</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/norma-o#annotationDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/norma-o#annotationDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#AnnotationActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date on which the annotation activity took place. Convenience shortcut; for instant-level precision use `prov:startedAtTime`/`prov:endedAtTime` from PROV-O (both are valid on prov:Activity, unlike prov:generatedAtTime which is defined on prov:Entity).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">annotation date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/norma-o#articleNumber -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/norma-o#articleNumber">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#LegalSource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Article, section, or equivalent unit number. Not functional: a single LegalSource may cover multiple articles.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">article number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/norma-o#conditionStatement -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/norma-o#conditionStatement">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#LegalCondition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Plain-language formulation of the legal condition evaluated at a BPMN gateway.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">condition statement</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/norma-o#conditionTrigger -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/norma-o#conditionTrigger">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#RegulativeNorm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Raw textual description of the condition under which the norm applies.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">condition trigger</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/norma-o#confidenceScore -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/norma-o#confidenceScore">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#AnnotationActivity"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</xsd:maxInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Confidence score the annotation activity assigned to its output, constrained to the closed interval [0,1]. Placed on the activity rather than the annotation entity to attribute uncertainty to the extraction process; downstream consumers traverse `prov:wasGeneratedBy` to reach it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">confidence score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/norma-o#deadline -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/norma-o#deadline">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Deadline, sunset date, end date, or textual temporal constraint associated with the normative content.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">deadline</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/norma-o#deonticId -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/norma-o#deonticId">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Unique identifier for a norm or constitutive rule within a regulation pack. The NORMA pipeline generates it from the modality prefix and the BPMN element label (e.g. OBL_Mark_AI_generated_content). Uniqueness is a pipeline invariant, not an OWL one; to enforce global uniqueness across graphs, declare InverseFunctionalProperty or add a SHACL uniqueness constraint.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">deontic ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/norma-o#effectiveDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/norma-o#effectiveDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date from which the normative content is effective.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">effective date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/norma-o#exception -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/norma-o#exception">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#RegulativeNorm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Exception or carve-out under which the norm does not apply.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">exception</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/norma-o#factStatement -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/norma-o#factStatement">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#ConstitutiveRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Plain-language statement of the constitutive rule.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">fact statement</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/norma-o#fromArticle -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/norma-o#fromArticle">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Denormalised article identifier copied from the linked LegalSource.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">from article</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/norma-o#fromParagraph -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/norma-o#fromParagraph">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Denormalised paragraph identifier copied from the linked LegalSource.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">from paragraph</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/norma-o#fromRegulation -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/norma-o#fromRegulation">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Denormalised regulation name copied from the linked LegalSource for convenient querying and SWRL rule generation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">from regulation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/norma-o#lastReviewDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/norma-o#lastReviewDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date of the most recent legal or editorial review of this annotation. A lifecycle property of the norm itself, not of the activity that created it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">last review date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/norma-o#normStatement -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/norma-o#normStatement">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Human-readable restatement of the norm or rule.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">norm statement</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/norma-o#objectText -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/norma-o#objectText">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#RegulativeNorm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Raw textual form of the legal object as entered in the annotation template.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">object text</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/norma-o#originalText -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/norma-o#originalText">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#LegalSource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Verbatim legal text from the legal source.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">original text</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/norma-o#paragraphNumber -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/norma-o#paragraphNumber">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#LegalSource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Paragraph, subsection, or equivalent granular locator. Not functional.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">paragraph number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/norma-o#regulationName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/norma-o#regulationName">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#LegalSource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of the legal or regulatory source.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">regulation name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/norma-o#regulationURI -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/norma-o#regulationURI">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#LegalSource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">URI identifying the legal source.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">regulation URI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/norma-o#sanction -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/norma-o#sanction">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#RegulativeNorm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Sanction or consequence associated with non-compliance.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">sanction</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/norma-o#sourceURI -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/norma-o#sourceURI">
        <rdfs:domain rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">Denormalised URI copied from the linked LegalSource.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">source URI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/norma-o#AnnotationActivity -->


    <owl:Class rdf:about="https://w3id.org/norma-o#AnnotationActivity">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment xml:lang="en">A provenance activity that produces a NORMA annotation (i.e. a NormativeContent) from one or more LegalSources.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">Annotation Activity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/norma-o#AnnotatorAgent -->


    <owl:Class rdf:about="https://w3id.org/norma-o#AnnotatorAgent">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:comment xml:lang="en">A provenance agent responsible for creating, reviewing, or attesting to a NORMA annotation. May represent a person (legal expert, analyst), a software system (LLM extractor, rule engine), or an organization. For finer-grained typing use the corresponding PROV-O subclasses (prov:Person, prov:SoftwareAgent, prov:Organization). Integrity constraint (not OWL-enforced): for a given NormativeContent, `prov:wasAttributedTo` and `prov:wasAssociatedWith` (via its generating AnnotationActivity) should resolve to the same agent; validate with SHACL.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">Annotator Agent</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/norma-o#BindingForce -->


    <owl:Class rdf:about="https://w3id.org/norma-o#BindingForce">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Binding force of a norm.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">Binding Force</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/norma-o#ComplianceCriticality -->


    <owl:Class rdf:about="https://w3id.org/norma-o#ComplianceCriticality">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Criticality level associated with non-compliance with a regulative norm.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">Compliance Criticality</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/norma-o#ConditionOutcome -->


    <owl:Class rdf:about="https://w3id.org/norma-o#ConditionOutcome">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A controlled outcome value produced by evaluating a LegalCondition. It is modelled as an extensible SKOS concept class so binary branches, multi-way gateway branches, exception branches, and decision-table outcomes can all be represented consistently.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">Condition Outcome</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/norma-o#ConstitutiveRule -->


    <owl:Class rdf:about="https://w3id.org/norma-o#ConstitutiveRule">
        <rdfs:subClassOf rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <owl:disjointWith rdf:resource="https://w3id.org/norma-o#RegulativeNorm"/>
        <rdfs:comment xml:lang="en">A normative content item that defines, classifies, or constitutes a legal concept, status, or institutional fact.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">Constitutive Rule</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/norma-o#ExtractionMethod -->


    <owl:Class rdf:about="https://w3id.org/norma-o#ExtractionMethod">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Method used to produce the annotation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">Extraction Method</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/norma-o#LegalAction -->


    <owl:Class rdf:about="https://w3id.org/norma-o#LegalAction">
        <rdfs:comment xml:lang="en">A normalized legal action that is prescribed, prohibited, permitted, or recommended by a regulative norm. NORMA pipeline consumers may work with the literal shortcut `norma:actionText` for low-ceremony use and mint LegalAction individuals only when the knowledge graph needs action-level reuse across norms.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">Legal Action</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/norma-o#LegalAgent -->


    <owl:Class rdf:about="https://w3id.org/norma-o#LegalAgent">
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <rdfs:comment xml:lang="en">An entity that bears the legally relevant role of subject of a regulative norm: the party that is obliged, prohibited, permitted, or recommended to perform a legal action. Instances should be further typed using foaf:Person, foaf:Organization, or foaf:Group to express whether the agent is a natural person, a legal entity (e.g. an AI provider, deployer, or operator), or a collective.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">Legal Agent</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/norma-o#LegalCondition -->


    <owl:Class rdf:about="https://w3id.org/norma-o#LegalCondition">
        <rdfs:comment xml:lang="en">A legally relevant condition, fact pattern, or decision criterion whose evaluated outcome determines whether normative content becomes applicable or is triggered. Branch-specific activation is represented using the n-ary TriggerEvent pattern via norma:hasTrigger.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">Legal Condition</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/norma-o#LegalObject -->


    <owl:Class rdf:about="https://w3id.org/norma-o#LegalObject">
        <rdfs:comment xml:lang="en">The entity, resource, person, document, system, content, or data item toward which the regulated action is directed.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">Legal Object</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/norma-o#LegalSource -->


    <owl:Class rdf:about="https://w3id.org/norma-o#LegalSource">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/eli/ontology#LegalResource"/>
        <rdfs:comment xml:lang="en">A legal resource (in the ELI sense: a work-level identity) from which normative content is extracted, cited, or traced.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">Legal Source</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/norma-o#LegalSourceExpression -->


    <owl:Class rdf:about="https://w3id.org/norma-o#LegalSourceExpression">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/eli/ontology#LegalExpression"/>
        <rdfs:comment xml:lang="en">A concrete legal expression of a LegalSource: a specific language, consolidation, or published version of the underlying legal resource. Follows the ELI work/expression pattern: a LegalSource is realised by one or more LegalSourceExpressions via `norma:hasSourceExpression` (subproperty of `eli:is_realized_by`).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">Legal Source Expression</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/norma-o#NegativeRecommendation -->


    <owl:Class rdf:about="https://w3id.org/norma-o#NegativeRecommendation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/norma-o#RegulativeNorm"/>
    </owl:Class>
    


    <!-- https://w3id.org/norma-o#NormStatus -->


    <owl:Class rdf:about="https://w3id.org/norma-o#NormStatus">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Lifecycle status of a normative content item.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">Norm Status</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/norma-o#NormativeContent -->


    <owl:Class rdf:about="https://w3id.org/norma-o#NormativeContent">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://data.europa.eu/eli/ontology#jurisdiction"/>
                <owl:allValuesFrom rdf:resource="http://data.europa.eu/eli/ontology#AdministrativeArea"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An informational entity that expresses machine-readable legal-normative content extracted or formulated from a legal source, either a regulative norm or a constitutive rule. Jurisdiction is represented only with eli:jurisdiction, whose value must be an eli:AdministrativeArea. If no authoritative URI is available yet, use a local provisional resource typed as eli:AdministrativeArea and provide its rdfs:label.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">Normative Content</rdfs:label>
        <skos:scopeNote xml:lang="en">Do not attach jurisdiction strings directly to NormativeContent. For extracted labels such as &quot;Spain&quot; or &quot;California&quot;, mint a local jurisdiction resource, type it as eli:AdministrativeArea, attach the extracted text as rdfs:label, and later align or replace it with an authoritative URI when available.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/norma-o#Obligation -->


    <owl:Class rdf:about="https://w3id.org/norma-o#Obligation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/norma-o#RegulativeNorm"/>
    </owl:Class>
    


    <!-- https://w3id.org/norma-o#Permission -->


    <owl:Class rdf:about="https://w3id.org/norma-o#Permission">
        <rdfs:subClassOf rdf:resource="https://w3id.org/norma-o#RegulativeNorm"/>
    </owl:Class>
    


    <!-- https://w3id.org/norma-o#Prohibition -->


    <owl:Class rdf:about="https://w3id.org/norma-o#Prohibition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/norma-o#RegulativeNorm"/>
    </owl:Class>
    


    <!-- https://w3id.org/norma-o#Recommendation -->


    <owl:Class rdf:about="https://w3id.org/norma-o#Recommendation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/norma-o#RegulativeNorm"/>
    </owl:Class>
    


    <!-- https://w3id.org/norma-o#RegulativeNorm -->


    <owl:Class rdf:about="https://w3id.org/norma-o#RegulativeNorm">
        <rdfs:subClassOf rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
        <rdfs:comment xml:lang="en">A normative content item that regulates conduct by prescribing, prohibiting, permitting, or recommending a legal action.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">Regulative Norm</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/norma-o#ReviewStatus -->


    <owl:Class rdf:about="https://w3id.org/norma-o#ReviewStatus">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Legal review status of an annotation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">Review Status</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/norma-o#TriggerEvent -->


    <owl:Class rdf:about="https://w3id.org/norma-o#TriggerEvent">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/norma-o#activatesNorm"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/norma-o#NormativeContent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/norma-o#hasOutcome"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/norma-o#ConditionOutcome"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Reified instance of the triggering relation between a legal condition, one evaluated condition outcome, and one activated normative content item. Represents true, false, and other branch-specific activations without using separate branch-label datatype properties. Follows Pattern 1 / Use Case 1 of the W3C Working Group Note Defining N-ary Relations on the Semantic Web.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">Trigger Event</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/norma-o -->


    <owl:NamedIndividual rdf:about="https://w3id.org/norma-o">
        <foaf:logo rdf:resource="https://w3id.org/norma-o/assets/logo.png"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/norma-o#Active -->


    <owl:NamedIndividual rdf:about="https://w3id.org/norma-o#Active">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/norma-o#NormStatus"/>
        <skos:inScheme rdf:resource="https://w3id.org/norma-o#NormStatusScheme"/>
        <skos:topConceptOf rdf:resource="https://w3id.org/norma-o#NormStatusScheme"/>
        <skos:notation>ACTIVE</skos:notation>
        <rdfs:comment xml:lang="en">Currently in force or active.</rdfs:comment>
        <rdfs:label xml:lang="en">Active</rdfs:label>
        <skos:prefLabel xml:lang="en">Active</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/norma-o#Approved -->


    <owl:NamedIndividual rdf:about="https://w3id.org/norma-o#Approved">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/norma-o#ReviewStatus"/>
        <skos:inScheme rdf:resource="https://w3id.org/norma-o#ReviewStatusScheme"/>
        <skos:topConceptOf rdf:resource="https://w3id.org/norma-o#ReviewStatusScheme"/>
        <skos:notation>APPROVED</skos:notation>
        <rdfs:comment xml:lang="en">Review status indicating that the annotation has been validated and accepted.</rdfs:comment>
        <rdfs:label xml:lang="en">Approved</rdfs:label>
        <skos:prefLabel xml:lang="en">Approved</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/norma-o#BindingForceScheme -->


    <owl:NamedIndividual rdf:about="https://w3id.org/norma-o#BindingForceScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/norma-o#Contractual"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/norma-o#HardLaw"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/norma-o#InternalPolicy"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/norma-o#SoftLaw"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <skos:definition xml:lang="en">SKOS concept scheme grouping binding-force values used by NORMA regulative norms.</skos:definition>
        <skos:prefLabel xml:lang="en">Binding force scheme</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/norma-o#ComplianceCriticalityScheme -->


    <owl:NamedIndividual rdf:about="https://w3id.org/norma-o#ComplianceCriticalityScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/norma-o#Critical"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/norma-o#High"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/norma-o#Low"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/norma-o#Medium"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <skos:definition xml:lang="en">SKOS concept scheme grouping compliance criticality values used by NORMA regulative norms.</skos:definition>
        <skos:prefLabel xml:lang="en">Compliance criticality scheme</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/norma-o#ConditionOutcomeScheme -->


    <owl:NamedIndividual rdf:about="https://w3id.org/norma-o#ConditionOutcomeScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/norma-o#FalseOutcome"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/norma-o#TrueOutcome"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <skos:definition xml:lang="en">Extensible SKOS scheme grouping condition outcome values used by NORMA trigger events.</skos:definition>
        <skos:prefLabel xml:lang="en">Condition outcome scheme</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/norma-o#Contractual -->


    <owl:NamedIndividual rdf:about="https://w3id.org/norma-o#Contractual">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/norma-o#BindingForce"/>
        <skos:inScheme rdf:resource="https://w3id.org/norma-o#BindingForceScheme"/>
        <skos:topConceptOf rdf:resource="https://w3id.org/norma-o#BindingForceScheme"/>
        <skos:notation>CONTRACTUAL</skos:notation>
        <rdfs:comment xml:lang="en">Binding force category for obligations, permissions, or constraints arising from a contract or agreement.</rdfs:comment>
        <rdfs:label xml:lang="en">Contractual</rdfs:label>
        <skos:prefLabel xml:lang="en">Contractual</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/norma-o#Critical -->


    <owl:NamedIndividual rdf:about="https://w3id.org/norma-o#Critical">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
