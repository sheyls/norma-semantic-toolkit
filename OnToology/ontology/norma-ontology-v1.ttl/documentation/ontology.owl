    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotations
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <rdf:Description rdf:about="https://w3id.org/norma-o#NegativeRecommendation">
        <rdfs:comment xml:lang="en">A regulative norm stating that a legal action is discouraged.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">Negative Recommendation</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/norma-o#Obligation">
        <rdfs:comment xml:lang="en">A regulative norm stating that a legal action is required.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">Obligation</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/norma-o#Permission">
        <rdfs:comment xml:lang="en">A regulative norm stating that a legal action is allowed.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">Permission</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/norma-o#Prohibition">
        <rdfs:comment xml:lang="en">A regulative norm stating that a legal action is forbidden.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">Prohibition</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/norma-o#Recommendation">
        <rdfs:comment xml:lang="en">A regulative norm stating that a legal action is recommended.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/norma-o"/>
        <rdfs:label xml:lang="en">Recommendation</rdfs:label>
    </rdf:Description>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // General axioms
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/norma-o#LegalAction"/>
            <rdf:Description rdf:about="https://w3id.org/norma-o#LegalAgent"/>
            <rdf:Description rdf:about="https://w3id.org/norma-o#LegalCondition"/>
            <rdf:Description rdf:about="https://w3id.org/norma-o#LegalObject"/>
            <rdf:Description rdf:about="https://w3id.org/norma-o#LegalSource"/>
            <rdf:Description rdf:about="https://w3id.org/norma-o#NormativeContent"/>
        </owl:members>
    </rdf:Description>
