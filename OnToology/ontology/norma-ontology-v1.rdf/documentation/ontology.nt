# #################################################################
# 
# 
# https://w3id.org/norma-ontology
<https://w3id.org/norma-ontology> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#NamedIndividual> .
<https://w3id.org/norma-ontology> <http://xmlns.com/foaf/0.1/logo> <https://w3id.org/norma-ontology/assets/logo.png> .
<https://w3id.org/norma-ontology/assets/logo.png> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#NamedIndividual> .
# 
# https://w3id.org/norma-ontology#Active
<https://w3id.org/norma-ontology#Active> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#NamedIndividual> .
<https://w3id.org/norma-ontology#Active> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> .
