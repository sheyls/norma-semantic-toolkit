###  https://w3id.org/def/norma-o/assets/norma-o.png
<https://w3id.org/def/norma-o/assets/norma-o.png> rdf:type owl:NamedIndividual .


#################################################################
#    Annotations
#################################################################

:LegalAction rdfs:comment "A normalized legal action that is prescribed, prohibited, permitted, or recommended by a regulative norm. NORMA pipeline consumers may work with the literal shortcut `norma:actionText` for low-ceremony use and mint LegalAction individuals only when the knowledge graph needs action-level reuse across norms."@en ;
             rdfs:isDefinedBy <https://w3id.org/def/norma-o> ;
             rdfs:label "Legal Action"@en .


:LegalAgent rdfs:comment "An entity that bears the legally relevant role of subject of a regulative norm: the party that is obliged, prohibited, permitted, or recommended to perform a legal action."@en ;
            rdfs:isDefinedBy <https://w3id.org/def/norma-o> ;
            rdfs:label "Legal Agent"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Conceptually close to lkif-la:Legal_Person (Natural_Person, Private_Legal_Person, Public_Body). skos:closeMatch is used rather than rdfs:subClassOf because lkif-la:Legal_Person also covers Legislative_Body — entities that utter norms rather than bear them — which falls outside NORMA's LegalAgent role, and because lkif-core/legal-action.owl is not imported. foaf:Agent is intentionally not asserted as a TBox parent because it is broader than legal personhood (it includes software agents and other non-legal entities); FOAF classes remain available for instance-level annotation."@en .


:NegativeRecommendation rdfs:comment "A regulative norm stating that a legal action is discouraged."@en ;
                        rdfs:isDefinedBy <https://w3id.org/def/norma-o> ;
                        rdfs:label "Negative Recommendation"@en .


:Obligation rdfs:comment "A regulative norm stating that a legal action is required."@en ;
            rdfs:isDefinedBy <https://w3id.org/def/norma-o> ;
            rdfs:label "Obligation"@en .


:Permission rdfs:comment "A regulative norm stating that a legal action is allowed."@en ;
            rdfs:isDefinedBy <https://w3id.org/def/norma-o> ;
            rdfs:label "Permission"@en .


:Prohibition rdfs:comment "A regulative norm stating that a legal action is forbidden."@en ;
             rdfs:isDefinedBy <https://w3id.org/def/norma-o> ;
             rdfs:label "Prohibition"@en .


:Recommendation rdfs:comment "A regulative norm stating that a legal action is recommended."@en ;
                rdfs:isDefinedBy <https://w3id.org/def/norma-o> ;
                rdfs:label "Recommendation"@en .


:RegulativeNorm rdfs:comment "A normative content item that regulates conduct by prescribing, prohibiting, permitting, or recommending a legal action."@en ;
                rdfs:isDefinedBy <https://w3id.org/def/norma-o> ;
                rdfs:label "Regulative Norm"@en ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Conceptually close to lkif:Norm in LKIF-Core. SKOS closeMatch is used rather than rdfs:subClassOf because lkif:Norm is equivalentClass to a restriction on lkif:qualifies (a property NORMA does not use) and because LKIF axiomatises the deontic operators as interdefinable (lkif:Obligation owl:equivalentClass lkif:Prohibition), which would conflict with NORMA's pairwise disjointness of regulative subclasses if formal subsumption were asserted."@en .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :LegalAction
                :LegalAgent
                :LegalCondition
                :LegalObject
                :LegalSource
                :NormativeContent
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :NegativeRecommendation
                :Obligation
                :Permission
                :Prohibition
                :Recommendation
              )
] .


